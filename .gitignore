# dependencies
node_modules/

# build output
dist/

# test / coverage
coverage/

# logs
*.log

# local sqlite database (migrate CLI default location)
data/

# environment variables（密钥绝不入库）
.env
.env.*
.env.*.local
!.env.example

# TypeScript build info
*.tsbuildinfo

# Astro
.astro/
.preview/

# Vercel CLI / local Build Output API artifacts (apps/report/.vercel/output)
.vercel/

# macOS
.DS_Store

# Playwright E2E artifacts
test-results/
playwright-report/
e2e/.tmp/
blob-report/

# Chrome extension signing key (fixes unpacked extension ID; public key is in manifest)
apps/extension/key.pem

# Chrome extension CWS release artifacts (produced by `pnpm release`)
apps/extension/release/

# Vercel CLI project link (`.vercel/` also covered above; do NOT add `.env*`
# here — the `!.env.example` whitelist above would stop working)
.vercel

# local resume outputs + PII (name/email/phone/work history) — never commit
resumes/
e2e/.tmp-agent/
