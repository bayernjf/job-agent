# JobAgent 环境变量模板（复制为 .env 并填写后使用；密钥绝不入库）
#
# CLI / github-source 需要 GitHub 访问凭证。
# 本地开发与离线实验：GitHub Settings → Developer settings → Fine-grained PAT，
# 只勾选 public repository 的只读权限（Metadata: Read、Contents: Read）。
# 生产环境改用 GitHub App（见 docs/技术选型-MVP-20260910.md 6.7 节）。

# GitHub 访问令牌（PAT / GitHub App 安装 token）
GITHUB_TOKEN=

# ─── 持久化（双方言，见 docs/design-storage-dual-dialect-20260911.md）───
# 数据库驱动：sqlite（本地默认，零外部依赖）| postgres（生产）
DB_DRIVER=sqlite
# SQLite 文件路径（DB_DRIVER=sqlite 时生效，内存库用 :memory:）
DB_PATH=data/job-agent.db
# Postgres 连接串（DB_DRIVER=postgres 时必填，postgres-js 驱动）
# 形如 postgres://user:password@host:5432/dbname
DATABASE_URL=
# 仅 CI/本地真实 PG 行为测试使用：提供后 storage 的 postgres 行为套件才会运行
DATABASE_TEST_URL=

# ─── P2 职位聚合（jobs sync，见 docs/design-job-ingestion-20260913.md）───
# 启用的数据源（逗号分隔，默认四源；HN 自由文本为 P2-C 暂不支持）
JOB_SYNC_SOURCES=remoteok,remotive,greenhouse,lever
# 单请求超时毫秒 / 失败重试次数（仅网络错、5xx、429 重试）
JOB_HTTP_TIMEOUT_MS=15000
JOB_HTTP_RETRIES=2
# 岗位连续 N 天未被任何源重新观测到则置 inactive
JOB_STALE_DAYS=7
# 出站 HTTP 代理（可选，留空直连；如 http://127.0.0.1:7897）
JOB_HTTP_PROXY=
