# JobAgent 环境变量模板（复制为 .env 并填写后使用；密钥绝不入库）
#
# CLI / github-source 需要 GitHub 访问凭证。
# 本地开发与离线实验：GitHub Settings → Developer settings → Fine-grained PAT，
# 只勾选 public repository 的只读权限（Metadata: Read、Contents: Read）。
# 生产环境改用 GitHub App（见 docs/技术选型-MVP-20260910.md 6.7 节）。

# GitHub 访问令牌（PAT / GitHub App 安装 token）
GITHUB_TOKEN=

# Gitee 访问令牌（可选；gitee-source 匿名即可读公开数据，token 仅用于提高匿名约 60 次/分的限额）
# CLI：jobagent analyze <user> --platform gitee；获取：Gitee 设置 → 私人令牌，仅公开只读
GITEE_TOKEN=

# ─── 持久化（双方言，见 docs/design-storage-dual-dialect-20260911.md）───
# 数据库驱动：sqlite（本地默认，零外部依赖）| postgres（生产）
DB_DRIVER=sqlite
# SQLite 文件路径（DB_DRIVER=sqlite 时生效，内存库用 :memory:）
DB_PATH=data/job-agent.db
# Postgres 连接串（DB_DRIVER=postgres 时必填，postgres-js 驱动）
# 形如 postgres://user:password@host:5432/dbname
DATABASE_URL=
# 仅 CI/本地真实 PG 行为测试使用：提供后 storage 的 postgres 行为套件才会运行
DATABASE_TEST_URL=

# ─── P2 职位聚合（jobs sync，见 docs/design-job-ingestion-20260913.md）───
# 日更数据源（逗号分隔，默认四源；HN「Who is hiring」是月度自由文本源，不进日更列表）
JOB_SYNC_SOURCES=remoteok,remotive,greenhouse,lever
# HN 月度源每月单独跑一次；markStale 全表不分源，故用 35 天阈值，避免把近 7 天刷过的日更岗误标 inactive：
#   jobagent jobs sync --source hn_whoishiring --stale-days 35
# 单请求超时毫秒 / 失败重试次数（仅网络错、5xx、429 重试）
JOB_HTTP_TIMEOUT_MS=15000
JOB_HTTP_RETRIES=2
# 岗位连续 N 天未被任何源重新观测到则置 inactive（日更源用 7；HN 月度源命令行用 --stale-days 35 覆盖）
JOB_STALE_DAYS=7
# 出站 HTTP(S) 代理（可选，留空直连；本机访问海外源不稳时填，如 http://127.0.0.1:7897）。
# 已生效：① job-source 采集；② API 服务端 GitHub OAuth 的 token 交换/拉用户——Node 全局 fetch 默认不读
#   代理 env，API 启动时按此变量安装 undici 全局 ProxyAgent（apps/api/src/proxy-bootstrap.ts）。
# 未设时回退标准 HTTPS_PROXY/HTTP_PROXY（含小写）；不影响 github-source。
JOB_HTTP_PROXY=

# ─── 服务运行（API / Worker / Report，均可选，不填用内置默认值）───
# API HTTP 端口（默认 3000）
PORT=3000
# Report（Astro SSR）监听端口（默认 4321）
REPORT_PORT=4321
# Worker 标识：多 Worker 并发时用于区分；不填则每次启动随机生成 worker-<8位>
WORKER_ID=
# Worker 轮询 analysis_jobs 的间隔毫秒（默认 5000）
POLL_INTERVAL_MS=5000
# 单个分析任务失败后的最大重试次数（默认 3）
MAX_RETRIES=3
# POST /analyze 命中未过期画像快照即直接返回的缓存时长毫秒（默认 24h = 86400000）
PROFILE_CACHE_TTL_MS=86400000

# ─── 岗位定向简历 · B 档 LLM 措辞润色（可选，默认关闭；见 docs/design-targeted-resume-20260915.md §7/§10、docs/API.md §3.4）───
# 不填 LLM_API_KEY：简历走纯规则版，零费用、零数据外发；POST /resumes/build 即使带 "polish":true
# 也返回 polish.applied=false、reason=not_configured。填写后启用，支持任意 OpenAI 兼容 /chat/completions
# 端点（OpenAI / DeepSeek / 通义兼容模式 / 智谱、Moonshot 兼容网关 / 本地 vLLM 等）。
# 凭证只在服务端读取，绝不入 Git、构建产物或前端；具体型号与单价以厂商当期官方定价为准，代码不内置。
LLM_API_KEY=
# 兼容端点根地址（含版本前缀），默认 https://api.openai.com/v1；DeepSeek 用 https://api.deepseek.com/v1
LLM_BASE_URL=
# 模型 id（启用时必填，缺失会在启动时报错——不替你默认某个付费模型），如 gpt-4o-mini / deepseek-chat
LLM_MODEL=
# provenance 中记录的提供方标识；留空按 LLM_BASE_URL 主机推断（openai/deepseek/qwen/...）
LLM_PROVIDER=
# 请求超时毫秒（默认 30000）；超时/非 2xx/非 JSON 一律回退规则版，不使请求失败
LLM_TIMEOUT_MS=

# ─── 前端 / 扩展构建时注入（构建期读取，可选）───
# Report 前端调用后端 API 的基址（Astro 的 PUBLIC_ 构建变量；留空走相对/同源路径，本地联调可填 http://localhost:3000）
PUBLIC_API_BASE=
# 报告页异议入口的收件邮箱（Astro PUBLIC_ 构建变量；留空回退 dispute@job-agent.bayjf.com）
PUBLIC_DISPUTE_EMAIL=
# 浏览器扩展请求后端的基址（esbuild 构建扩展时读取，默认 http://localhost:3000）
EXTENSION_API_BASE=http://localhost:3000

# ─── 演示模式 Demo Mode（见 docs/design-demo-mode-20260915.md；均可选，不填用内置默认，配额值待 §16 拍板）───
# 演示会话有效期毫秒（默认 7 天 = 604800000）
DEMO_SESSION_TTL_MS=604800000
# 单个演示会话可触发的新分析次数（硬配额，默认 3）
DEMO_ANALYZE_QUOTA=3
# platform=all 双源融合一次作业扣减的会话配额（约 2x 采集成本，默认 2；单源 github/gitee 扣 1，最小 1）
DEMO_FUSION_QUOTA_COST=2
# 同一 IP 每小时可创建演示会话数 / 可触发分析次数 / 可请求岗位匹配次数（滑动窗口）
DEMO_SESSION_RATE_PER_HOUR=5
DEMO_ANALYZE_RATE_PER_HOUR=10
DEMO_MATCH_RATE_PER_HOUR=60
# Worker 同时处理的演示分析任务上限（正式任务永不被闸）与超闸后退回重试的退避毫秒
DEMO_MAX_CONCURRENT=1
DEMO_BACKOFF_MS=15000
# IP 哈希盐（留空则进程内随机，重启后历史 IP 窗口失效；生产应固定一个随机密钥）
DEMO_IP_SALT=
# 预置示例账号清单（格式 platform:login，逗号分隔；CLI `jobagent demo seed` 也读它；默认空）
# 建议三态各一（likely/mixed/suspicious），需先用 analyze 预热入库：
DEMO_PRESET_LOGINS=github:torvalds,github:bayernjf,github:MSNightmare
# 跨子域部署（形态 B）时允许携带演示 Cookie 的来源白名单（逗号分隔）；留空则 CORS 为 '*' 且不发凭证
CORS_ALLOW_ORIGINS=
# 部署在反向代理后时置 true，才采信 X-Forwarded-For 首段作为客户端 IP（默认 false）
TRUST_PROXY=false

# ─── 账号登录 · GitHub OAuth（决策 #1-A/#6-A 本人授权主脊；均可选，不填则登录路由返回 501，其余功能照常）───
# 在 GitHub → Settings → Developer settings → OAuth Apps → New OAuth App 创建：
#   本地 Authorization callback URL 填 http://localhost:3000/auth/github/callback
#   生产填 https://<你的域名>/auth/github/callback（或用 AUTH_CALLBACK_BASE_URL 固定）
# client id/secret 只在服务端读取，绝不入 Git、构建产物或前端。
# 注意：回调里服务端需直连 github.com 换 token；本机直连受限时在上面配置 JOB_HTTP_PROXY（或 HTTPS_PROXY）。
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── 账号登录 · Gitee OAuth（决策 #4 海内外同步；与 GitHub 对称，均可选，不填则 Gitee 登录路由返回 501）───
# 在 Gitee → 设置 → 第三方应用 → 创建应用 中创建：
#   回调地址填 http://localhost:3000/auth/gitee/callback
#   生产填 https://<你的域名>/auth/gitee/callback（或用 AUTH_CALLBACK_BASE_URL 固定）
# scope 固定 user_info（仅读公开身份 id/login/name/头像，邮箱可能为空）。
# 与 GitHub 共用下方 AUTH_STATE_SECRET / AUTH_CALLBACK_BASE_URL / AUTH_SESSION_TTL_MS 等配置。
GITEE_OAUTH_CLIENT_ID=
GITEE_OAUTH_CLIENT_SECRET=
# 登录会话有效期毫秒（默认 30 天 = 2592000000），同时是 jobagent_session Cookie 的 Max-Age
AUTH_SESSION_TTL_MS=2592000000
# OAuth state 的 HMAC 签名密钥（留空则进程内随机，重启会使进行中的登录失效；生产多实例必须固定一个随机值）
AUTH_STATE_SECRET=
# OAuth 回调基址（留空=运行时按请求 Origin/Host 推导；生产反代/跨子域时显式填 https://<域名>，不带尾斜杠）
AUTH_CALLBACK_BASE_URL=
# 登录成功后跳转地址（默认 '/' 同源首页；前后端分离时填报告页/落地页地址）
AUTH_AFTER_LOGIN_URL=/

# ─── 生产部署：Vercel + Supabase（形态 C，见 docs/deployment-runbook-20260920.md 形态 C）───
# 内部 cron 端点（/api/internal/cron/*）的共享密钥：配了就要求 cron 路径带 ?token=<该值>
# （常量时间比较）；不配则仅信任 Vercel 平台注入的 x-vercel-cron: 1 请求头。生产必须配置。
# 生成：openssl rand -hex 32；vercel.json 的 crons 路径里的 REPLACE_WITH_CRON_SECRET 同步替换。
CRON_SECRET=

# Supabase Postgres（DB_DRIVER=postgres）：
# - 函数运行时用「Transaction」池化串（端口 6543，带 ?pgbouncer=true）：
#     postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#   连接工厂识别 pgbouncer=true/6543 后自动 prepare=false（事务池化不支持会话级 prepared statements）。
# - 迁移/DDL 用「Session」池化或直连（端口 5432），在本地用 CLI 跑 `pnpm migrate:pg:up`，
#   不要让 serverless 冷启动走池化串执行迁移；Vercel 环境显式设 DB_AUTO_MIGRATE=false 兜底。
#   （未设置时维持默认：非只读打开即自动迁移；仅接受小写 true/false。）
DB_AUTO_MIGRATE=
# - Supabase 项目区域建议与 Vercel functions region（vercel.json 现设 hnd1 东京）一致。
#
# API 在同源下的挂载前缀（形态 C 设为 /api）：只影响对外 OAuth redirect_uri 与临时
# state/return Cookie 的 Path；Hono 内部路由仍在 /auth/*，由报告页 /api/* 转发层剥前缀。
# 根挂载（本地/Docker 直连 3000 端口）留空。
API_MOUNT_PREFIX=
#
# Vercel 项目环境变量（在 Vercel 控制台配置，不写进本文件）：
#   DB_DRIVER=postgres；DATABASE_URL=<上面的 6543 事务池化串>；API_MOUNT_PREFIX=/api；DB_AUTO_MIGRATE=false；
#   GITHUB_TOKEN/GITHUB_OAUTH_*、GITEE_TOKEN/GITEE_OAUTH_*、LLM_*、DEMO_IP_SALT、AUTH_STATE_SECRET、CRON_SECRET；
#   AUTH_CALLBACK_BASE_URL=https://<生产域名>（同域形态即 https://app.job-agent.bayjf.com，不含 /api）；
#   TRUST_PROXY=true（Vercel 在反向代理后，需采信 X-Forwarded-For 做演示限流）；
#   AUTH_AFTER_LOGIN_URL=https://<生产域名>/zh-CN/；
#   OAuth App 回调：https://<生产域名>/api/auth/github/callback 与 /api/auth/gitee/callback（API 同域挂在 /api）。
# 报告页浏览器侧 API 基址在 Vercel 上自动回退为同域 '/api'（见 apps/report/src/lib/api-base.ts），
# 一般无需再设 PUBLIC_API_BASE；仅跨域部署时才显式设置。
