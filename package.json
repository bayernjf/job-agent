{
  "name": "job-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "migrate:up": "pnpm --filter @jobagent/storage exec node dist/cli.js up",
    "migrate:down": "pnpm --filter @jobagent/storage exec node dist/cli.js down",
    "migrate:status": "pnpm --filter @jobagent/storage exec node dist/cli.js status",
    "migrate:pg:up": "pnpm --filter @jobagent/storage exec node dist/cli.js up --driver postgres",
    "migrate:pg:down": "pnpm --filter @jobagent/storage exec node dist/cli.js down --driver postgres",
    "migrate:pg:status": "pnpm --filter @jobagent/storage exec node dist/cli.js status --driver postgres",
    "check:migrations": "bash tools/check-migrations.sh",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:agent": "pnpm --filter @jobagent/api... build && playwright test -c playwright.agent.config.ts",
    "e2e:extension": "pnpm --filter @jobagent/extension build && playwright test -c playwright.extension.config.ts",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jobagent/shared": "workspace:*",
    "@jobagent/storage": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "devalue": ">=5.9.3",
      "fast-uri": ">=3.1.9",
      "http-cache-semantics": ">=4.3.0",
      "@vercel/routing-utils>path-to-regexp": "^6.3.0",
      "sharp": ">=0.35.5",
      "source-map-js": "^1.2.2",
      "smol-toml": "^1.9.0",
      "undici": "7.30.1",
      "body-parser": ">=2.4.0",
      "ip-address": ">=10.7.4",
      "@vercel/cli-config>zod": ">=4.6.6",
      "vite": "^8.3.3"
    }
  }
}
