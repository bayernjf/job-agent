#!/usr/bin/env bash
#
# migrate-down — roll back the latest applied migration by one step.
#
# Delegates to the storage package CLI (MIGRATION_CONVENTION 第 5 节):
# the latest migration is refused when it has no safe down script.
#
# Usage: ./scripts/migrate-down [--db <path>]
# Default database: DB_PATH when set, else <repo>/data/job-agent.db

set -euo pipefail

cd "$(dirname "$0")/.."

pnpm --filter @jobagent/storage exec node dist/cli.js down "$@"
