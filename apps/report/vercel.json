{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && ASTRO_ADAPTER=vercel pnpm --filter @jobagent/report... build",
  "regions": ["hnd1"],
  "crons": [
    {
      "path": "/api/internal/cron/cleanup?task=all",
      "schedule": "17 3 * * *"
    }
  ]
}
