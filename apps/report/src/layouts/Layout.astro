---
/**
 * 基础布局——全局引入设计 token 和样式，设置 HTML lang，提供导航和语言切换。
 * 所有页面共享此布局。
 */
import '../styles/tokens.css';
import '../styles/global.css';
import { createTranslator, type Locale, type MessageKey } from '../i18n/index.js';
import DemoBanner from '../components/DemoBanner.tsx';
import AccountMenu from '../components/AccountMenu.tsx';
import { browserApiBase } from '../lib/api-base.js';

interface Props {
  locale: Locale;
  titleKey?: MessageKey;
  title?: string;
  /** robots 指令；招聘方视图等内部页传 noindex,nofollow */
  robots?: string;
  /**
   * Open Graph / Twitter 卡（design-share-proof-card-20261030 §1.1）。
   * 仅分享门面页（报告页）传入；不传则完全不渲染 og/twitter 标签，
   * 其余页面 head 零回归。ogImage 必须是绝对地址（爬虫要求）。
   */
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
}

const { locale, titleKey, title, robots = 'index,follow', ogTitle, ogDescription, ogImage, ogUrl } = Astro.props;
const t = createTranslator(locale);
const otherLocale: Locale = locale === 'zh-CN' ? 'en' : 'zh-CN';

// API 地址：显式 PUBLIC_API_BASE 优先；Vercel 同域为 /api；本地默认同源
const apiBase = browserApiBase();
const disputeEmail =
  (import.meta.env.PUBLIC_DISPUTE_EMAIL as string | undefined) ?? 'dispute@job-agent.bayjf.com';

const pageTitle = title
  ? `${title} · ${t('app.name')}`
  : titleKey
    ? `${t(titleKey)} · ${t('app.name')}`
    : `${t('app.name')} · ${t('app.tagline')}`;

// 当前路径用于语言切换（替换语言段）
const currentPath = Astro.url.pathname;
const langSwitchPath = currentPath.replace(`/${locale}/`, `/${otherLocale}/`) || `/${otherLocale}/`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t('app.tagline')} />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {ogTitle && <meta property="og:title" content={ogTitle} />}
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogTitle && <meta property="og:type" content="profile" />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
  </head>
  <body>
    <DemoBanner
      client:load
      apiBase={apiBase}
      label={t('demo.banner.label')}
      remainingLabel={t('demo.banner.remaining')}
      exitLabel={t('demo.banner.exit')}
    />
    <header class="header">
      <div class="header-inner">
        <a href={`/${locale}/`} class="logo">
          <strong>{t('app.name')}</strong>
        </a>
        <nav class="nav-main">
          <a href={`/${locale}/`}>{t('nav.home')}</a>
          <a href={`/${locale}/my`}>{t('nav.my')}</a>
          <a href={`/${locale}/workbench`}>{t('nav.workbench')}</a>
          <a href={`/${locale}/usage`}>{t('nav.usage')}</a>
        </nav>
        <div class="nav-actions">
          <AccountMenu
            client:load
            apiBase={apiBase}
            locale={locale}
            signInLabel={t('account.signInGithub')}
            signInGiteeLabel={t('account.signInGitee')}
            signOutLabel={t('account.signOut')}
            menuLabel={t('account.menuLabel')}
            myLabel={t('nav.my')}
            claimedLabel={t('my.claimedLabel')}
            recruiterBadgeLabel={t('account.recruiterBadge')}
            declareLabel={t('account.declareRecruiter')}
            declareConfirm={t('account.declareConfirm', { email: disputeEmail })}
            revokeLabel={t('account.revokeRecruiter')}
            revokeConfirm={t('account.revokeConfirm', { email: disputeEmail })}
            actionFailedLabel={t('account.recruiterActionFailed')}
            adminLabel={t('account.admin')}
          />
          <a href={langSwitchPath} class="lang-switch">{t('nav.language')}</a>
        </div>
      </div>
    </header>

    <main class="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="ja-container">
        <p class="ja-muted">{t('app.name')} · {t('app.tagline')}</p>
        <p class="footer-links">
          <a href={`/${locale}/recruit`}>{t('nav.recruit')}</a>
          <a href={`/${locale}/privacy`}>{t('nav.privacy')}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .header {
    background: var(--ja-color-surface);
    border-bottom: 1px solid var(--ja-color-border);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    max-width: var(--ja-container-max);
    margin: 0 auto;
    padding: var(--ja-space-3) var(--ja-space-5);
    display: flex;
    align-items: center;
    gap: var(--ja-space-4);
  }

  .logo {
    font-size: var(--ja-text-lg);
    color: var(--ja-color-fg);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo:hover {
    text-decoration: none;
    color: var(--ja-color-accent);
  }

  /* 两级头部（走查 #10）：一级主导航靠左、二级账号操作区固定右侧，
     语言切换在操作区内固定位置，不随账号菜单展开/折叠跳动。 */
  .nav-main {
    display: flex;
    align-items: center;
    gap: var(--ja-space-4);
    margin-left: var(--ja-space-6);
    min-width: 0;
  }

  .nav-main a {
    font-size: var(--ja-text-sm);
    color: var(--ja-color-fg-muted);
    white-space: nowrap;
  }

  .nav-main a:hover {
    color: var(--ja-color-accent);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--ja-space-3);
    margin-left: auto;
    flex-shrink: 0;
  }

  .lang-switch {
    padding: var(--ja-space-1) var(--ja-space-3);
    border: 1px solid var(--ja-color-border);
    border-radius: var(--ja-radius-md);
    white-space: nowrap;
  }

  /* 移动端：第一行 logo + 账号操作区，第二行主导航换行（2026-10-12 生产 360px 走查修复延续） */
  @media (max-width: 640px) {
    .header-inner {
      flex-wrap: wrap;
      gap: var(--ja-space-2);
      padding: var(--ja-space-2) var(--ja-space-3);
    }

    .nav-main {
      flex-basis: 100%;
      order: 2;
      flex-wrap: wrap;
      gap: var(--ja-space-2) var(--ja-space-3);
      margin-left: 0;
    }

    .nav-actions {
      margin-left: auto;
    }

    .lang-switch {
      padding: var(--ja-space-1) var(--ja-space-2);
    }
  }

  .main {
    min-height: calc(100vh - 120px);
  }

  .footer {
    border-top: 1px solid var(--ja-color-border);
    padding: var(--ja-space-5) 0;
    margin-top: var(--ja-space-8);
    text-align: center;
  }

  .footer-links {
    margin-top: var(--ja-space-2);
  }

  .footer-links a {
    font-size: var(--ja-text-sm);
    color: var(--ja-color-fg-muted);
  }

  .footer-links a:hover {
    color: var(--ja-color-accent);
  }
</style>
