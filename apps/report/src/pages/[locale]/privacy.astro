const sections = locale === 'zh-CN' ? zhCN : en;
---

<Layout locale={locale} titleKey="privacy.title" robots="index,follow">
  <article class="ja-container privacy-page">
    <h1>{t('privacy.title')}</h1>
    <p class="ja-muted privacy-updated">{t('privacy.lastUpdated', { date: lastUpdated })}</p>
    {sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.blocks.map((block) => (
          <>
            {block.kind === 'p' && <p>{block.text}</p>}
            {block.kind === 'sub' && <h3>{block.text}</h3>}
            {block.kind === 'list' && (
              <ul>
                {block.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
            {block.kind === 'table' && (
              <div class="privacy-table-wrap">
                <table>
                  <thead>
                    <tr>{block.head.map((cell) => <th>{cell}</th>)}</tr>
                  </thead>
                  <tbody>
                    {block.rows.map((row) => (
                      <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </>
        ))}
      </section>
    ))}
  </article>
</Layout>

<style>
  .privacy-page {
    max-width: 800px;
    padding: var(--ja-space-6) var(--ja-space-5);
  }

  .privacy-updated {
    margin-bottom: var(--ja-space-6);
  }

  .privacy-page h1 {
    font-size: var(--ja-text-2xl);
    margin-bottom: var(--ja-space-2);
  }

  .privacy-page h2 {
    font-size: var(--ja-text-lg);
    margin-top: var(--ja-space-6);
    margin-bottom: var(--ja-space-3);
  }

  .privacy-page h3 {
    font-size: var(--ja-text-base);
    margin-top: var(--ja-space-4);
    margin-bottom: var(--ja-space-2);
  }

  .privacy-page p,
  .privacy-page li,
  .privacy-page td,
  .privacy-page th {
    font-size: var(--ja-text-sm);
    line-height: 1.7;
    color: var(--ja-color-fg-muted);
  }

  .privacy-page ul {
    padding-left: var(--ja-space-5);
    margin: var(--ja-space-2) 0;
    list-style: disc;
  }

  .privacy-page li {
    margin-bottom: var(--ja-space-2);
  }

  .privacy-table-wrap {
    overflow-x: auto;
    margin: var(--ja-space-3) 0;
  }

  .privacy-page table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--ja-color-border);
    border-radius: var(--ja-radius-md);
  }

  .privacy-page th,
  .privacy-page td {
    text-align: left;
    padding: var(--ja-space-2) var(--ja-space-3);
    border-bottom: 1px solid var(--ja-color-border);
    vertical-align: top;
  }

  .privacy-page th {
    color: var(--ja-color-fg);
    background: var(--ja-color-surface);
  }
</style>
