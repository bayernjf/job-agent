---
/**
 * 隐私政策页 /[locale]/privacy（CWS 上架要求可公开访问的隐私政策 URL）。
 *
 * i18n 约定例外说明：短 UI 串（标题/导航/更新日期）走 t()；法律正文是长篇结构化
 * 内容，作为本文件内的内容数据（content as data）按 locale 选取，与"报告内容来自
 * 数据"同理，不塞进扁平 i18n JSON。权威源同步 docs/privacy-policy-20260924.md，
 * 两处内容变更必须一起改。
 */
import Layout from '../../layouts/Layout.astro';
import { isLocale, createTranslator, type Locale } from '../../i18n/index.js';

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) {
  return Astro.redirect('/en/privacy');
}
const locale: Locale = rawLocale;
const t = createTranslator(locale);

const disputeEmail =
  (import.meta.env.PUBLIC_DISPUTE_EMAIL as string | undefined) ??
  'dispute@job-agent.bayjf.com';

type Block =
  | { kind: 'p'; text: string }
  | { kind: 'sub'; text: string }
  | { kind: 'list'; items: string[] }
  | { kind: 'table'; head: [string, string, string]; rows: [string, string, string][] };

interface PrivacySection {
  heading: string;
  blocks: Block[];
}

const lastUpdated = '2026-09-24';

const en: PrivacySection[] = [
  {
    heading: '1. Information we process',
    blocks: [
      {
        kind: 'p',
        text: 'This policy covers the JobAgent web service (the ability-report site and its API) and the JobAgent Autofill browser extension. JobAgent analyzes public developer activity on GitHub and Gitee to produce evidence-backed ability profiles, matches profiles to job postings, and helps fill out application forms on supported applicant tracking systems (ATS). We design JobAgent to collect as little personal data as possible.',
      },
      { kind: 'sub', text: '1.1 Public code-platform data (core feature)' },
      {
        kind: 'p',
        text: 'When you submit a GitHub or Gitee username, we call the platform official API to read public information only: the public profile, public repositories, and public commits, pull requests and issues. We never clone repositories, never request access to private repositories, and never ask for your code-platform password. Every profile conclusion links back to the public evidence.',
      },
      { kind: 'sub', text: '1.2 Sign-in data (only if you choose to log in)' },
      {
        kind: 'p',
        text: 'You can use the core report without an account. If you sign in with GitHub or Gitee OAuth to claim a profile, we receive your public username/display name and, where provided, an email address (GitHub user:email, which may be empty; Gitee user_info). Your email is never returned by the who-am-I API endpoint and is never shown to other users.',
      },
      { kind: 'sub', text: '1.3 Technical data for anonymous demo rate limiting' },
      {
        kind: 'p',
        text: 'Anonymous demo usage is rate limited. Without storing your IP address, we store only a salted SHA-256 hash of your IP together with an opaque session identifier and timestamps; we cannot reconstruct your IP from the hash. Demo sessions expire after 24 hours.',
      },
      { kind: 'sub', text: '1.4 Contact details you enter — kept on your device, never uploaded' },
      {
        kind: 'p',
        text: 'The name, email, phone number, LinkedIn URL, location and personal website you type into the extension panel or the resume form are stored only in your browser local storage. They are not transmitted to or persisted on our servers, and are written only into the application form you are viewing, only when you click the fill/apply action yourself. You can erase them at any time by clearing the extension local data.',
      },
      { kind: 'sub', text: '1.5 Resumes you generate' },
      {
        kind: 'p',
        text: 'Targeted resumes are assembled in your browser / on your own machine from your profile and the job posting. We do not store resume documents or local profile fields on the server. Optional AI polish is off by default; when an operator-configured OpenAI-compatible endpoint is set, only the resume text you choose to polish is sent there, and the feature falls back to rule-based output otherwise.',
      },
      { kind: 'sub', text: '1.6 Strictly necessary cookies and client storage' },
      {
        kind: 'p',
        text: 'After OAuth sign-in we set an HTTP-only session cookie. The extension uses the Chrome storage permission for on-device contact details (1.4). We do not use advertising or cross-site tracking cookies.',
      },
    ],
  },
  {
    heading: '2. Information we do NOT collect',
    blocks: [
      {
        kind: 'list',
        items: [
          'Your GitHub, Gitee or ATS passwords — the extension never sees or types a password field, and OAuth never asks for one.',
          'Private repositories, private issues, or any non-public code-platform data.',
          'Payment or billing information.',
          'Browsing history outside supported career/job pages; the extension activates only on Greenhouse, Lever, Workday and URLs containing careers or jobs.',
          'Salary, demographic (EEO), visa-authorization or similar sensitive ATS fields — autofill deliberately leaves these blank for you.',
        ],
      },
    ],
  },
  {
    heading: '3. How we use information',
    blocks: [
      {
        kind: 'list',
        items: [
          'To generate, store and display evidence-backed profiles and shareable report pages.',
          'To match profiles with aggregated public job postings and prefill supported application forms.',
          'To authenticate sign-in and profile claims.',
          'To prevent abuse of the anonymous demo quota.',
          'To operate, secure and debug the service (hosting-platform server logs).',
        ],
      },
      { kind: 'p', text: 'We do not sell personal data, and we do not use it for advertising.' },
    ],
  },
  {
    heading: '4. Sharing and subprocessors',
    blocks: [
      {
        kind: 'table',
        head: ['Subprocessor', 'Purpose', 'Data potentially exposed'],
        rows: [
          ['Vercel (hosting, Tokyo)', 'Web service, API and scheduled functions', 'Request metadata, IP (for the salted hash), service data'],
          ['Supabase / PostgreSQL (Tokyo)', 'Primary database', 'Profiles, evidence, accounts, sessions, rate-limit hashes'],
          ['GitHub / Gitee official APIs', 'Source of public developer data', 'The username you submit; public data returned'],
          ['Operator-configured LLM endpoint (optional, off by default)', 'Resume text polishing', 'Resume text you choose to polish'],
        ],
      },
      {
        kind: 'p',
        text: 'When you click through to a job posting or submit an application, you leave JobAgent and interact directly with that third-party ATS, whose own privacy policy applies.',
      },
    ],
  },
  {
    heading: '5. Data retention and deletion',
    blocks: [
      {
        kind: 'list',
        items: [
          'Ability profiles and evidence are retained long-term so shared report links stay stable and verifiable.',
          'Share links do not expire automatically.',
          'On request we delete a profile/evidence and revoke a share link via the contact email below.',
          'Demo sessions expire after 24 hours; expired sign-in sessions and unclaimed accounts are purged by a scheduled cleanup job.',
          'On-device contact details and resumes remain until you clear them locally.',
        ],
      },
    ],
  },
  {
    heading: '6. International data transfers',
    blocks: [
      {
        kind: 'p',
        text: 'The production service is hosted in the Tokyo region (Vercel hnd1, Supabase Northeast Asia). GitHub/Gitee public data is read from their respective APIs. The product is designed for both Chinese and international users.',
      },
    ],
  },
  {
    heading: '7. Your rights',
    blocks: [
      {
        kind: 'list',
        items:
          [
            'View everything we hold about a username by opening its report page.',
            'Request deletion and share-link revocation by email.',
            'Clear all locally stored contact details yourself (extension / browser site data).',
            'Sign out, which ends your session cookie.',
          ],
      },
      { kind: 'p', text: 'We respond to verifiable requests within a reasonable period.' },
    ],
  },
  {
    heading: '8. Children',
    blocks: [
      {
        kind: 'p',
        text: 'JobAgent is a professional developer tool not directed at children; we do not knowingly collect data from anyone under 16 (or the minimum age in your jurisdiction).',
      },
    ],
  },
  {
    heading: '9. Security',
    blocks: [
      {
        kind: 'p',
        text: 'Credentials and secrets are held only in server-side environment variables. The extension talks to the API through its background service worker, never touches password fields, and sends on-device contact details only into the form you explicitly submit. Profiles are stored as immutable snapshots so evidence cannot silently change after a report is shared.',
      },
    ],
  },
  {
    heading: '10. Changes and contact',
    blocks: [
      {
        kind: 'p',
        text: 'We may update this policy; material changes update the last-updated date and this page. Questions, correction/deletion requests and objections:',
      },
      { kind: 'p', text: disputeEmail },
    ],
  },
];

const zhCN: PrivacySection[] = [
