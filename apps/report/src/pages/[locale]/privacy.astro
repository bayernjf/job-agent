  {
    heading: '4. 共享与受托处理方',
    blocks: [
      {
        kind: 'table',
        head: ['受托方', '用途', '可能接触的数据'],
        rows: [
          ['Vercel（托管，东京）', '网站、API 与定时函数', '请求元数据、IP（用于加盐哈希）、业务数据'],
          ['Supabase / PostgreSQL（东京）', '主数据库', '画像、证据、账号、会话、限流哈希'],
          ['GitHub / Gitee 官方 API', '公开开发者数据来源', '你提交的用户名、平台返回的公开数据'],
