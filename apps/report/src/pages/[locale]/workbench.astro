            low: t('workbench.tiers.low'),
          },
          actions: {
            refresh: t('workbench.actions.refresh'),
          },
          errors: {
            preferences: t('workbench.errors.preferences'),
            runs: t('workbench.errors.runs'),
            intents: t('workbench.errors.intents'),
            code: {
              AGENT_PREFERENCE_NOT_FOUND: t('workbench.errors.code.preferenceNotFound'),
              AGENT_RUN_NOT_FOUND: t('workbench.errors.code.runNotFound'),
              AGENT_INTENT_NOT_FOUND: t('workbench.errors.code.intentNotFound'),
