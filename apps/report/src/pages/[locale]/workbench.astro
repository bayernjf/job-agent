---
/**
 * 求职工作台 /[locale]/workbench（设计 docs/设计-求职Agent-20261002.md §3/§5/§6 阶段 1）。
 *
 * 与 /my 同构：SSR 直读只读 storage 解析身份（resolveViewer），未登录走纯 SSR 登录墙
 * （GateCard + 同源 return_to）；登录后 SSR 预取本人画像列表作为 island 的可序列化 props，
 * 其余数据（偏好/任务/事件流/待投清单）由 island 带 credentials:'include' 向 API 取。
 *
 * 阶段 1 的硬边界：**Agent 只准备、人执行**——本页只出匹配报告与定向材料，
 * 投递动作永远由用户在岗位页自己完成（设计 §4 原则 1）。
 * i18n 在服务端完成：所有用户可见文案经 t() 拼好，按 labels 传给岛，岛内零硬编码。
 */
import Layout from '../../layouts/Layout.astro';
import GateCard from '../../components/GateCard.astro';
import AgentWorkbench from '../../components/AgentWorkbench.tsx';
import ModelSettings from '../../components/ModelSettings.tsx';
import { isLocale, createTranslator, type Locale } from '../../i18n/index.js';
import { getStorage } from '../../lib/db.js';
import { resolveViewer } from '../../lib/auth.js';
import { browserApiBase } from '../../lib/api-base.js';

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) {
  return Astro.redirect('/en/');
}
const locale: Locale = rawLocale;
const t = createTranslator(locale);
const apiBase = browserApiBase();

const viewer = await resolveViewer(Astro.request.headers.get('cookie'));
const storage = await getStorage();
const profiles =
  viewer.kind === 'user'
    ? await storage.profiles.listBySubject(viewer.platform, viewer.login)
    : [];
const loginHref = `${apiBase}/auth/github/login?return_to=${encodeURIComponent(`/${locale}/workbench`)}`;

/** island props 必须可序列化：只投影 id + 人类可读标题（同 /my 的 headline 口径）。 */
const initialProfiles = profiles.map((p) => ({
  profileId: p.id,
  headline: p.snapshot?.summary?.headline ?? p.subjectLogin,
}));
const claimedProfileId = viewer.kind === 'user' ? viewer.claimedProfileId : null;
---

<Layout locale={locale} titleKey="workbench.title" robots="noindex,nofollow">
  <div class="workbench-page ja-container">
    {viewer.kind !== 'user' ? (
      <>
        <header class="workbench-header">
          <h1>{t('workbench.title')}</h1>
          <p class="ja-muted">{t('workbench.subtitle')}</p>
        </header>
        <GateCard
          title={t('workbench.gateTitle')}
          body={t('workbench.gateBody')}
          loginHref={loginHref}
          loginLabel={t('workbench.gateLogin')}
          testId="workbench-gate"
        />
      </>
    ) : (
      <AgentWorkbench
        client:load
        apiBase={apiBase}
        locale={locale}
        initialProfiles={initialProfiles}
        claimedProfileId={claimedProfileId}
        profileHintHref={`/${locale}/`}
        labels={{
          title: t('workbench.title'),
          subtitle: t('workbench.subtitle'),
          loading: t('workbench.loading'),
          error: t('workbench.error'),
          noProfileHint: t('workbench.noProfileHint'),
          noProfileAction: t('workbench.noProfileAction'),
          preferences: {
            title: t('workbench.preferences.title'),
            hint: t('workbench.preferences.hint'),
            loading: t('workbench.loading'),
            empty: t('workbench.preferences.empty'),
            add: t('workbench.preferences.add'),
            create: t('workbench.preferences.create'),
            cancel: t('workbench.preferences.cancel'),
            delete: t('workbench.preferences.delete'),
            createdAt: t('workbench.preferences.createdAt'),
            labelLabel: t('workbench.preferences.labelLabel'),
            labelPlaceholder: t('workbench.preferences.labelPlaceholder'),
            titlesLabel: t('workbench.preferences.titlesLabel'),
            titlesPlaceholder: t('workbench.preferences.titlesPlaceholder'),
            skillsLabel: t('workbench.preferences.skillsLabel'),
            skillsPlaceholder: t('workbench.preferences.skillsPlaceholder'),
            locationsLabel: t('workbench.preferences.locationsLabel'),
            locationsPlaceholder: t('workbench.preferences.locationsPlaceholder'),
            remoteOnlyLabel: t('workbench.preferences.remoteOnlyLabel'),
            salaryLabel: t('workbench.preferences.salaryLabel'),
            salaryPlaceholder: t('workbench.preferences.salaryPlaceholder'),
            minTierLabel: t('workbench.preferences.minTierLabel'),
            dailySubmitLimitLabel: t('workbench.preferences.dailySubmitLimitLabel'),
            required: t('workbench.preferences.required'),
          },
          runs: {
            title: t('workbench.runs.title'),
            hint: t('workbench.runs.hint'),
            loading: t('workbench.loading'),
            empty: t('workbench.runs.empty'),
            create: t('workbench.runs.create'),
            scan: t('workbench.runs.scan'),
            cancel: t('workbench.runs.cancel'),
            profileLabel: t('workbench.runs.profileLabel'),
            noProfileOption: t('workbench.runs.noProfileOption'),
            preferenceLabel: t('workbench.runs.preferenceLabel'),
            noPreferenceOption: t('workbench.runs.noPreferenceOption'),
            selectHint: t('workbench.runs.selectHint'),
            attempts: t('workbench.runs.attempts'),
