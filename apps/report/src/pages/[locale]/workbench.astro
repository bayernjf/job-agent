            candidatesReady: t('workbench.eventKinds.candidatesReady'),
            generated: t('workbench.eventKinds.generated'),
            approve: t('workbench.eventKinds.approve'),
            reject: t('workbench.eventKinds.reject'),
            rescan: t('workbench.eventKinds.rescan'),
