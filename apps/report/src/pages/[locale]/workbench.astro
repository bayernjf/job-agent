      />
    )}
  </div>
</Layout>

<style>
  .workbench-page {
    display: flex;
    flex-direction: column;
    gap: var(--ja-space-4);
  }
  .workbench-header {
    display: flex;
    flex-direction: column;
    gap: var(--ja-space-1);
  }
</style>
