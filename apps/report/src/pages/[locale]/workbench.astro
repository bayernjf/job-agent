      />
      <ModelSettings
        client:load
        apiBase={apiBase}
        locale={locale}
        labels={{
          title: t('modelSettings.title'),
          subtitle: t('modelSettings.subtitle'),
          baseUrl: t('modelSettings.baseUrl'),
          model: t('modelSettings.model'),
