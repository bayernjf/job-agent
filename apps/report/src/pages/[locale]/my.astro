---
/**
 * "我的"页 /[locale]/my（T17，评审 P0-3「回访即失联」）：
 * 登录后找回自己的全部画像——接上此前零调用的 profiles.listBySubject。
 * SSR 直读只读 storage：身份用 resolveViewer 解析；未登录见登录墙（GateCard）。
 */
import Layout from '../../layouts/Layout.astro';
import GateCard from '../../components/GateCard.astro';
import InterviewPlanner from '../../components/InterviewPlanner.tsx';
import DeleteProfileButton from '../../components/DeleteProfileButton.tsx';
import { isLocale, createTranslator, type Locale } from '../../i18n/index.js';
import { getStorage } from '../../lib/db.js';
import { resolveViewer } from '../../lib/auth.js';
import { browserApiBase } from '../../lib/api-base.js';

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) {
  return Astro.redirect('/en/');
}
const locale: Locale = rawLocale;
const t = createTranslator(locale);
const apiBase = browserApiBase();

const viewer = await resolveViewer(Astro.request.headers.get('cookie'));
const storage = await getStorage();
const profiles =
  viewer.kind === 'user'
    ? await storage.profiles.listBySubject(viewer.platform, viewer.login)
    : [];
// 回访闭环：任务排队数小时是这套部署的真实形态（消费靠定时轮询），用户回来看的第一样东西
// 应该是"我发起的分析到哪一步了"，而不是只有已完成的画像。仓储的 listBySubject 此前零调用。
const recentJobs =
  viewer.kind === 'user'
    ? await storage.jobs.listBySubject(viewer.platform, viewer.login, 10)
    : [];
// 复盘样本的唯一来源是回标；回标的界面在工作台（agent 票据）与报告页「投递追踪」（任意来源）。
// 这里只计数与引导，不复制第三份编辑控件——同一个字段多处写口迟早漂移。
// origin 过滤随 item126 撤掉：PATCH /applications/:id 现在也能回标，四种来源都可标，
// 于是"提示 counted 了标不上的行"这个洞从写侧被补掉，而不是靠计数装看不见。
const pendingOutcomes =
  viewer.kind === 'user'
    ? (
        await Promise.all(
          profiles.slice(0, 10).map((p) => storage.applications.listByProfile(p.id)),
        )
      )
        .flat()
        .filter((a) => a.status === 'applied' && !a.outcomeFeedback)
    : [];
const jobStatusLabels: Record<string, string> = {
  queued: t('job.queued'),
  running: t('job.running'),
  succeeded: t('job.succeeded'),
  failed: t('job.failed'),
};
const loginHref = `${apiBase}/auth/github/login?return_to=${encodeURIComponent(`/${locale}/my`)}`;
const dateFmt = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'zh-CN', {
  dateStyle: 'medium',
});
---

<Layout locale={locale} titleKey="my.title" robots="noindex,nofollow">
  <div class="my-page ja-container">
    <header class="my-header">
      <h1>{t('my.title')}</h1>
      <p class="ja-muted">{t('my.subtitle')}</p>
    </header>

    {viewer.kind !== 'user' ? (
      <GateCard
        title={t('my.gateTitle')}
        body={t('my.gateBody')}
        loginHref={loginHref}
        loginLabel={t('my.gateLogin')}
        testId="my-gate"
      />
    ) : profiles.length === 0 ? (
      <div class="ja-card my-empty">
        <p>{t('my.empty')}</p>
        <a class="ja-btn" href={`/${locale}/`}>
          {t('my.emptyCta')}
        </a>
      </div>
    ) : (
      <ul class="my-profile-list">
        {profiles.map((p) => (
          <li class="ja-card my-profile-item" key={p.id} id={`my-profile-${p.id}`}>
            <a class="my-profile-link" href={`/${locale}/report/${p.id}`}>
              <span class="my-profile-title">
                {p.snapshot?.summary?.headline ?? p.subjectLogin}
              </span>
              <span class="my-profile-meta">
                <span class={`my-status my-status--${p.status}`}>{p.status}</span>
                <span class="ja-muted">
                  {t('my.updatedAt')}: {dateFmt.format(new Date(p.updatedAt))}
                </span>
              </span>
            </a>
            <DeleteProfileButton
              client:load
              apiBase={apiBase}
              profileId={p.id}
              cardId={`my-profile-${p.id}`}
              deleteLabel={t('my.delete')}
              confirmTitle={t('my.deleteConfirmTitle')}
              confirmBody={t('my.deleteConfirmBody')}
              cancelLabel={t('my.deleteCancel')}
              okLabel={t('my.deleteOk')}
              errorLabel={t('my.deleteError')}
              hintLabel={t('my.deleteHint')}
            />
          </li>
        ))}
      </ul>
    )}

    {viewer.kind === 'user' && recentJobs.length > 0 && (
      <section class="my-jobs" data-testid="my-jobs" aria-labelledby="my-jobs-title">
        <h2 id="my-jobs-title" class="my-jobs-title">{t('my.jobsTitle')}</h2>
        <p class="ja-muted">{t('my.jobsHint')}</p>
        <ul class="my-jobs-list">
          {recentJobs.map((j) => (
            <li class="my-job-item" key={j.id} id={`my-job-${j.id}`}>
              <span class={`my-status my-status--${j.status}`}>
                {jobStatusLabels[j.status] ?? j.status}
              </span>
              <span class="ja-muted">{dateFmt.format(new Date(j.createdAt))}</span>
              {j.status === 'succeeded' && j.profileId ? (
                <a href={`/${locale}/report/${j.profileId}`}>{t('my.jobsOpen')}</a>
              ) : j.status === 'failed' ? (
                <span class="ja-muted my-job-error">{j.errorMessage ?? ''}</span>
              ) : (
                <span class="ja-muted">{t('my.jobsWaiting')}</span>
              )}
              <code class="my-job-id">{j.id}</code>
            </li>
          ))}
        </ul>
      </section>
    )}

    {viewer.kind === 'user' && pendingOutcomes.length > 0 && (
      <section class="my-jobs" data-testid="my-pending-outcomes" aria-labelledby="my-outcomes-title">
        <h2 id="my-outcomes-title" class="my-jobs-title">{t('my.outcomesTitle')}</h2>
        <p class="ja-muted">
          {t('my.outcomesHint').replace('{count}', String(pendingOutcomes.length))}
        </p>
        <ul class="my-jobs-list">
          {pendingOutcomes.slice(0, 8).map((a) => (
            <li class="my-job-item" key={a.id}>
              <span>{a.targetTitle}</span>
              <span class="ja-muted">{a.targetCompany}</span>
              <span class="ja-muted">{dateFmt.format(new Date(a.appliedAt))}</span>
              <a href={`/${locale}/report/${a.profileId}`}>{t('my.outcomesOpen')}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {viewer.kind === 'user' && profiles.length > 0 && (
      <InterviewPlanner
        client:load
        apiBase={apiBase}
        locale={locale}
        loginHref={loginHref}
        labels={{
          title: t('interviews.title'),
          hint: t('interviews.hint'),
          loading: t('interviews.loading'),
          error: t('interviews.error'),
          empty: t('interviews.empty'),
          add: t('interviews.add'),
          save: t('interviews.save'),
          cancel: t('interviews.cancel'),
          required: t('interviews.required'),
          loginRequiredTitle: t('interviews.loginRequiredTitle'),
          loginRequiredBody: t('interviews.loginRequiredBody'),
          loginButton: t('interviews.loginButton'),
          application: t('interviews.application'),
          applicationNone: t('interviews.applicationNone'),
          applicationPlaceholder: t('interviews.applicationPlaceholder'),
          role: t('interviews.role'),
          rolePlaceholder: t('interviews.rolePlaceholder'),
          company: t('interviews.company'),
          companyPlaceholder: t('interviews.companyPlaceholder'),
          start: t('interviews.start'),
          end: t('interviews.end'),
          format: t('interviews.format'),
          round: t('interviews.round'),
          roundPlaceholder: t('interviews.roundPlaceholder'),
          interviewer: t('interviews.interviewer'),
          interviewerPlaceholder: t('interviews.interviewerPlaceholder'),
          interviewerEmail: t('interviews.interviewerEmail'),
          interviewerEmailPlaceholder: t('interviews.interviewerEmailPlaceholder'),
          status: t('interviews.status'),
          outcome: t('interviews.outcome'),
          outcomeUnset: t('interviews.outcomeUnset'),
          rating: t('interviews.rating'),
          ratingUnset: t('interviews.ratingUnset'),
          feedback: t('interviews.feedback'),
          feedbackPlaceholder: t('interviews.feedbackPlaceholder'),
          saveResult: t('interviews.saveResult'),
          noProfile: t('interviews.noProfile'),
          noProfileAction: t('interviews.noProfileAction'),
          statusLabels: {
            scheduled: t('interviews.status.scheduled'),
            completed: t('interviews.status.completed'),
            cancelled: t('interviews.status.cancelled'),
            no_show: t('interviews.status.no_show'),
            rescheduled: t('interviews.status.rescheduled'),
          },
          formatLabels: {
            onsite: t('interviews.format.onsite'),
            phone: t('interviews.format.phone'),
            video: t('interviews.format.video'),
          },
          outcomeLabels: {
            strong_yes: t('interviews.outcome.strong_yes'),
            yes: t('interviews.outcome.yes'),
            neutral: t('interviews.outcome.neutral'),
            no: t('interviews.outcome.no'),
          },
        }}
      />
    )}
  </div>
</Layout>

<style>
  .my-page {
    display: flex;
    flex-direction: column;
    gap: var(--ja-space-4);
  }
  .my-header {
    display: flex;
    flex-direction: column;
    gap: var(--ja-space-1);
  }
  .my-profile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ja-space-3);
  }
  .my-profile-item {
    margin: 0;
  }
  .my-profile-link {
    display: flex;
    flex-direction: column;
    gap: var(--ja-space-1);
    text-decoration: none;
    color: var(--ja-color-fg);
  }
  .my-profile-title {
    font-weight: 600;
  }
  .my-profile-meta {
    display: flex;
    align-items: center;
    gap: var(--ja-space-3);
    font-size: var(--ja-text-sm);
  }
  .my-status {
    padding: 2px var(--ja-space-2);
    border-radius: var(--ja-radius-sm);
    font-size: var(--ja-text-xs);
  }
  .my-status--complete {
    background: var(--ja-color-success-bg);
    color: var(--ja-color-success-fg);
  }
  .my-status--partial {
    background: var(--ja-color-accent-subtle);
    color: var(--ja-color-accent);
  }
  .my-empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ja-space-2);
  }
  /* 回访闭环：作业状态用的是队列枚举（queued/running/succeeded/failed），
     与画像的 complete/partial 不同，所以各补一枚徽标色。 */
  .my-jobs {
    margin-top: var(--ja-space-6);
  }
  .my-jobs-title {
    margin: 0 0 var(--ja-space-1);
    font-size: var(--ja-text-lg);
  }
  .my-jobs-list {
    display: flex;
    flex-direction: column;
    gap: var(--ja-space-2);
    margin: var(--ja-space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .my-job-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ja-space-3);
    padding: var(--ja-space-2) var(--ja-space-3);
    border: 1px solid var(--ja-color-border);
    border-radius: var(--ja-radius-md);
  }
  .my-job-error {
    max-width: 40ch;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .my-job-id {
    font-family: var(--ja-font-mono);
    font-size: var(--ja-text-xs);
    color: var(--ja-color-fg-muted);
  }
  .my-status--queued,
  .my-status--running {
    background: var(--ja-color-accent-subtle);
    color: var(--ja-color-accent);
  }
  .my-status--succeeded {
    background: var(--ja-color-success-bg);
    color: var(--ja-color-success-fg);
  }
  .my-status--failed {
    background: var(--ja-color-danger-bg);
    color: var(--ja-color-danger-fg);
  }
</style>
