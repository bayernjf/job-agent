---
/**
 * 报告页 /[locale]/report/[profileId]——SSR 读取画像快照并渲染。
 * 分享链接固定指向此路由，语言段随链接固定（i18n 设计第 4 节）。
 *
 * Q2 拆分后：数据装配（加载画像/派生展示数据/授权分级）抽到 lib/report-page.ts，
 * 页面专属样式抽到 styles/report-page.css；本文件只保留参数处理、redirect 与模板。
 */
import Layout from '../../../layouts/Layout.astro';
import ShareButton from '../../../components/ShareButton.tsx';
import ClaimProfile from '../../../components/ClaimProfile.tsx';
import UnclaimProfile from '../../../components/UnclaimProfile.tsx';
import RemovalRequest from '../../../components/RemovalRequest.tsx';
import GateCard from '../../../components/GateCard.astro';
import JobRecommendations from '../../../components/JobRecommendations.tsx';
import ResumeBuilder from '../../../components/ResumeBuilder.tsx';
import ApplicationTracker from '../../../components/ApplicationTracker.tsx';
import ClaimVerifier from '../../../components/ClaimVerifier.tsx';
import '../../../styles/report-page.css';
import { formatNumber, formatPercent } from '../../../lib/format';
import {
  loadReportPageData,
  composeCadenceSummary,
  composeImprovementSuggestion,
  composeInterviewIntent,
  composePrSummary,
  composeSignalDetail,
  composeSignalLabel,
  prSummaryFactsFromProfile,
} from '../../../lib/report-page';
import type { MessageKey, SkillTagKind } from '@jobagent/shared';

const { locale: rawLocale, profileId } = Astro.params;
const pageData = await loadReportPageData({
  rawLocale,
  profileId,
  url: Astro.url,
  cookieHeader: Astro.request.headers.get('cookie'),
});
if (pageData.kind === 'redirect') {
  return Astro.redirect(pageData.to);
}
const {
  locale,
  t,
  apiBase,
  profile,
  isPartialProfile,
  subjectClaimed,
  isFusedProfile,
  isHeldForRemoval,
  headline,
  fusionStats,
  isRecruiter,
  recruiterUrl,
  candidateUrl,
  canViewGated,
  canUseApplications,
  isProfileOwner,
  loginHref,
  gateLoginLabel,
  gateEvidenceBody,
  gateInterviewBody,
  resolveEvidence,
  authLabelKey,
  authClass,
  skillGroups,
  shareUrl,
  resumeJobId,
  generatedAt,
  since,
  until,
  interviewKitUrl,
  applicationStatusLabels,
  applicationOutcomeLabels,
  disputeEmail,
} = pageData;
---

<Layout locale={locale} title={profile.subject.login}>
  <div class="ja-container">
    <!-- T25：采集/分析有缺失（partial）时顶部显式标注，不冒充完整画像（NFR-6） -->
    {isPartialProfile && (
      <div class="ja-alert ja-alert--partial" data-testid="partial-notice" role="status">
        {t('report.partialNotice')}
      </div>
    )}
    <!-- S3 软挂起：画像已收到移除申请、处理中（不再被公开分发） -->
    {isHeldForRemoval && (
      <div class="ja-alert ja-alert--removal" data-testid="removal-notice" role="status">
        {t('report.removal.notice')}
      </div>
    )}
    <!-- 头部：账号信息 + 真实性徽章 + 分享 -->
    <section class="ja-card profile-header">
      <div class="profile-id">
        {
          profile.subject.avatarUrl && (
            <img src={profile.subject.avatarUrl} alt={profile.subject.login} class="avatar" width="64" height="64" />
          )
        }
        <div>
          <h1 class="login">{profile.subject.displayName ?? profile.subject.login}</h1>
          <a href={profile.subject.profileUrl} target="_blank" rel="noopener noreferrer" class="ja-muted">
            @{profile.subject.login}
          </a>
        </div>
      </div>
      <div class="header-meta">
        {isFusedProfile && (
          <span class={`ja-badge ja-badge--fused`} title={t('report.fusion.badgeTitle')}>
            {t('report.fusion.badge')}
          </span>
        )}
        {
          /* 已认领：SSR 直接渲染本人已验证徽章，无需 JS */
          subjectClaimed && (
            <>
              <span class="ja-badge ja-badge--owner" data-testid="claimed-badge">
                {t('report.claimedBadge')}
              </span>
              <UnclaimProfile
                client:load
                apiBase={apiBase}
                profileId={profileId!}
                subjectPlatform={isFusedProfile ? 'all' : profile.subject.platform}
                subjectLogin={profile.subject.login}
                ctaLabel={t('report.unclaim.cta')}
                confirmMessage={t('report.unclaim.confirm')}
                unclaimingLabel={t('report.unclaim.unclaiming')}
                errorLabel={t('report.unclaim.error')}
                hintLabel={t('report.unclaim.hint')}
              />
            </>
          )
        }
        {
          /* 未认领：挂载认领 island；单源画像要求平台+登录名一致，融合画像（subjectPlatform='all'）
             任一源（GitHub/Gitee 同 login）命中即可看到 CTA（T19） */
          !subjectClaimed && (
            <div id="claim-section" class="claim-anchor">
              <ClaimProfile
                client:load
                apiBase={apiBase}
                profileId={profileId!}
                subjectPlatform={isFusedProfile ? 'all' : profile.subject.platform}
                subjectLogin={profile.subject.login}
                ctaLabel={t('report.claim.cta')}
                claimingLabel={t('report.claim.claiming')}
                claimedBadge={t('report.claimedBadge')}
                errorLabel={t('report.claim.error')}
                hintLabel={t('report.claim.hint')}
                unclaimedNoticeTestId="unclaimed-notice"
              />
            </div>
          )}
          {
            /* 2026-10-08 走查 #5：移除申请不再占主操作位（合规入口曾排 header 第一个按钮）。
               S3 按主体撤回的入口降级到页面底部「数据主体权益」区（data-rights），本人/访客
               都可从页脚找到；已软挂起（isHeldForRemoval）由顶部标注条接管，底部不再重复。 */
          }
        <span class={`ja-badge ${authClass}`}>{t(authLabelKey)}</span>
        <a
          class="ja-btn ja-btn--ghost view-toggle"
          href={isRecruiter ? candidateUrl : recruiterUrl}
          aria-pressed={isRecruiter}
        >
          {isRecruiter ? t('report.view.switchToCandidate') : t('report.view.switchToRecruiter')}
        </a>
        <ShareButton
          client:load
          url={shareUrl}
          copyLabel={t('report.copyLink')}
          copiedLabel={t('report.shareCopied')}
        />
      </div>
      {
        isFusedProfile && fusionStats.length > 0 && (
          <p class="ja-fusion-stats" data-testid="fusion-stats">
            {fusionStats.map((s) => (
              <span class="ja-fusion-stat">
                <strong>{s.n}</strong>&nbsp;{t(s.labelKey)}
              </span>
            ))}
          </p>
        )
      }
      {
        /* 决策 #1-A：未授权画像必须显著标注来源与效力边界 */
        !subjectClaimed && (
          <p class="unclaimed-notice" data-testid="unclaimed-notice" role="note">
            {t('report.unclaimedNotice')}
          </p>
        )
      }
    </section>

    <!-- 行动出口（2026-10-08 走查 #6）：报告页此前 10 区块并列、看完没有"下一步"。
         这里按身份态给求职者一条主路径：认领 → 定向简历 → 记录投递。显示条件：
         未认领画像对任何人显示（引导主体本人认领）；已认领画像只对本人显示
         （别人的画像不暴露"认领/简历"路径）。招聘方视图一律不显示。 -->
    {
      !isRecruiter && (subjectClaimed ? isProfileOwner : true) && (
        <section class="ja-card journey" data-testid="journey">
          <h2>{t('report.journey.title')}</h2>
          <p class="ja-muted journey-lead">{t('report.journey.lead')}</p>
          <ol class="journey-steps">
            <li class={subjectClaimed ? 'journey-step journey-step--done' : 'journey-step'}>
              <span class="journey-step__label">
                <strong>1. {t('report.journey.step1')}</strong>
                {
                  subjectClaimed ? (
                    <span class="ja-badge ja-badge--owner journey-step__status">
                      {t('report.journey.step1Done')}
                    </span>
                  ) : (
                    <a class="ja-link journey-step__cta" href="#claim-section">
                      {t('report.journey.go')} →
                    </a>
                  )
                }
              </span>
            </li>
            <li class="journey-step">
              <span class="journey-step__label">
                <strong>2. {t('report.journey.step2')}</strong>
                {
                  subjectClaimed ? (
                    <a class="ja-link journey-step__cta" href="#resume-section">
                      {t('report.journey.go')} →
                    </a>
                  ) : (
                    <span class="ja-muted journey-step__locked">{t('report.journey.locked')}</span>
                  )
                }
              </span>
            </li>
            <li class="journey-step">
              <span class="journey-step__label">
                <strong>3. {t('report.journey.step3')}</strong>
                {
                  isProfileOwner ? (
                    <a class="ja-link journey-step__cta" href="#applications-section">
                      {t('report.journey.go')} →
                    </a>
                  ) : (
                    <span class="ja-muted journey-step__locked">{t('report.journey.locked')}</span>
                  )
                }
              </span>
            </li>
          </ol>
        </section>
      )
    }

    <!-- 下一步动作（T10）：只渲染 improvementSuggestions 里带证据的条目，
         文案按读者语言由 shared 的模板现拼；招聘方视图不需要这栏（那是给本人的建议）。 -->
    {
      !isRecruiter &&
        profile.improvementSuggestions &&
        profile.improvementSuggestions.length > 0 && (
          <section class="ja-card next-steps" data-testid="next-steps">
            <h2>{t('report.nextSteps.title')}</h2>
            <p class="ja-muted next-steps-lead">{t('report.nextSteps.lead')}</p>
            <ol class="ja-stack-2 next-steps-list">
              {
                profile.improvementSuggestions.map((s) => {
                  const copy = composeImprovementSuggestion(s.code, locale);
                  const refs = resolveEvidence(s.evidenceRefs);
                  return (
                    <li class="next-step">
                      <p class="next-step-action">{copy.suggestion}</p>
                      <p class="ja-muted next-step-why">{t('report.nextSteps.why')}: {copy.why}</p>
                      {
                        refs.length > 0 &&
                          (canViewGated ? (
                            <ul class="next-step-evidence">
                              <li class="ja-muted">{t('report.nextSteps.evidence')}:</li>
                              {refs.map((ev) => (
                                <li>
                                  <a href={ev.url} target="_blank" rel="noopener noreferrer">
                                    {ev.claim} ↗
                                  </a>
                                </li>
                              ))}
                            </ul>
                          ) : (
                            <p class="ja-muted">
                              {t('report.nextSteps.evidenceHidden', { count: refs.length })}
                            </p>
                          ))
                      }
                    </li>
                  );
                })
              }
            </ol>
          </section>
        )
    }

    {
      isRecruiter &&
        (canViewGated ? (
          <section class="ja-card recruiter-banner">
            <p>{t('report.view.recruiterBanner')}</p>
          </section>
        ) : (
          <GateCard
            title={t('report.gate.evidenceTitle')}
            body={gateEvidenceBody}
            loginHref={loginHref}
            loginLabel={gateLoginLabel}
            testId="evidence-gate"
          />
        ))
    }

    <!-- 元信息：生成时间 / 版本 / 时间窗 -->
    <section class="meta-bar">
      <span class="ja-muted">{t('report.generatedAt')}: {generatedAt}</span>
      <span class="ja-muted">{t('report.analyzerVersion')}: {profile.analyzerVersion}</span>
      <span class="ja-muted">{t('report.dataWindow')}: {since} – {until}</span>
    </section>

    <!-- 概述 -->
    <section class="ja-card">
      <h2>{t('report.summary.title')}</h2>
      <p class="headline">{headline}</p>
      <p class="ja-alert ja-alert--verifiable">{t('report.verifiability.banner')}</p>
    </section>

    <!-- 真实性评估 -->
    <section class="ja-card">
      <div class="ja-flex-between">
        <h2>{t('report.authenticity.title')}</h2>
        <span class="ja-muted">
          {t('report.authenticity.confidence')}: {formatPercent(profile.authenticity.confidence, locale)}
        </span>
      </div>
      <div class="ja-stack-2 signals">
        {
          profile.authenticity.signals.map((signal) => {
            const sigEvidence = isRecruiter && canViewGated ? resolveEvidence(signal.evidenceRefs) : [];
            return (
              <div class={`signal signal--${signal.severity}`}>
                <div class="ja-flex-between">
                  <strong>{composeSignalLabel(signal.code, locale, signal.label)}</strong>
                  {/* 内部码降噪（走查 #9）：保留可审计性，但不再是与结论等权重的可见文本——
                      次级字号 + 悬浮提示；招聘方需要时可从 evidenceRefs 溯源 */}
                  <code class="signal-code" title={t('report.authenticity.signalCodeTitle')}>{signal.code}</code>
                </div>
                <p>{composeSignalDetail(signal.code, locale, signal.detail, signal.facts)}</p>
                {
                  isRecruiter && canViewGated && sigEvidence.length > 0 && (
                    <ul class="evidence-links">
                      {sigEvidence.map((ev) => (
                        <li>
                          <a href={ev.url} target="_blank" rel="noopener noreferrer">
                            {ev.claim} ↗
                          </a>
                        </li>
                      ))}
                    </ul>
                  )
                }
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- 能力标签 -->
    {
      profile.skillTags.length > 0 && (
        <section class="ja-card">
          <h2>{t('report.skills.title')}</h2>
          <div class="ja-stack-3">
            {(Object.keys(skillGroups) as SkillTagKind[]).map((kind) =>
              skillGroups[kind].length > 0 ? (
                <div>
                  <h3 class="kind-label">{t(`report.skills.kind.${kind}` as MessageKey)}</h3>
                  <div class="tag-list">
                    {skillGroups[kind].map((tag) => (
                      <span class={`skill-tag skill-tag--${tag.depth}`}>
                        {tag.name}
                        <span class="depth-mark">{t(`report.skills.depth.${tag.depth}` as MessageKey)}</span>
                      </span>
                    ))}
                  </div>
                </div>
              ) : null,
            )}
            {
              isRecruiter && canViewGated && (
                <div class="skill-evidence">
                  <h3 class="kind-label">{t('report.recruiter.skillEvidence')}</h3>
                  <ul class="ja-stack-1">
                    {profile.skillTags.flatMap((tag) =>
                      resolveEvidence(tag.evidenceRefs).map((ev) => (
                        <li class="skill-evidence-row">
                          <span class="skill-evidence-name">{tag.name}</span>
                          <a href={ev.url} target="_blank" rel="noopener noreferrer">
                            {ev.claim} ↗
                          </a>
                        </li>
                      )),
                    )}
                  </ul>
                </div>
              )
            }
          </div>
        </section>
      )
    }

    <!-- 简历声明核验（B 端）：仅招聘方视角且已登录；未登录由上方证据门接管，
         island 自身再对 401/403 fail-closed 收起（决策 #23 批次 2，design §7）。 -->
    {
      isRecruiter && canViewGated && (
        <ClaimVerifier
          client:load
          apiBase={apiBase}
          profileId={profileId!}
          labels={{
            title: t('report.claims.recruiter.title'),
            hint: t('report.claims.recruiter.hint'),
            inputLabel: t('report.claims.inputLabel'),
            inputPlaceholder: t('report.claims.inputPlaceholder'),
            submit: t('report.claims.submit'),
            submitting: t('report.claims.submitting'),
            loading: t('report.claims.loading'),
            error: t('report.claims.error'),
            empty: t('report.claims.empty'),
            evidenceTitle: t('report.claims.evidence'),
            withdraw: t('report.claims.withdraw'),
            withdrawing: t('report.claims.withdrawing'),
            verdict: {
              supportable: t('report.claims.verdict.supportable'),
              partial: t('report.claims.verdict.partial'),
              no_trace: t('report.claims.verdict.no_trace'),
              insufficient_data: t('report.claims.verdict.insufficient_data'),
            },
          }}
        />
      )
    }

    <!-- 推荐岗位（第一档匹配接线）——仅求职者视角 -->
    {
      !isRecruiter && profile.skillTags.length > 0 && (
        <JobRecommendations
          client:load
          profileId={profileId!}
          apiBase={apiBase}
          locale={locale}
          title={t('report.recommendations.title')}
          loadingText={t('report.recommendations.loading')}
          errorText={t('report.recommendations.error')}
          emptyText={t('report.recommendations.empty')}
          scoreLabel={t('report.recommendations.score')}
          matchedSkillsLabel={t('report.recommendations.matchedSkills')}
          viewJobLabel={t('report.recommendations.viewJob')}
          remoteLabel={t('report.recommendations.remote')}
          basisLabel={t('report.recommendations.basis')}
          fieldTitleLabel={t('report.recommendations.fieldTitle')}
          fieldTagsLabel={t('report.recommendations.fieldTags')}
          fieldDescriptionLabel={t('report.recommendations.fieldDescription')}
          depthUsedLabel={t('report.skills.depth.used')}
          depthProficientLabel={t('report.skills.depth.proficient')}
          evidenceCountTemplate={t('report.evidence.count')}
          viewEvidenceLabel={t('report.evidence.viewOriginal')}
          generateResumeLabel={t('report.resume.generateButton')}
          loadMoreLabel={t('report.recommendations.loadMore')}
          alternateSourcesLabel={t('report.recommendations.alternateSources')}
        />
      )
    }

    <!-- 岗位定向简历（P-R2）：由上方岗位卡片按钮经 DOM 事件触发——仅求职者视角。
         T29：去掉 skillTags 门控——零技能/薄画像也必须能走到自选岗位表单（T15 同族：
         画像不完整不等于没有出路），简历内核自有 insufficient_data 显式标注。 -->
    {
      !isRecruiter && (
        <div id="resume-section" class="resume-anchor">
          <p class="resume-extension-hint" data-testid="resume-extension-hint">
            <a class="ja-link" href="https://github.com/bayernjf/job-agent/tree/main/apps/extension" target="_blank" rel="noopener noreferrer">
              {t('report.resume.extensionHint')}
            </a>
          </p>
          <ResumeBuilder
          client:load
          profileId={profileId!}
          apiBase={apiBase}
          locale={locale}
          initialJobId={resumeJobId}
          labels={{
            sectionTitle: t('report.resume.sectionTitle'),
            sectionHint: t('report.resume.sectionHint'),
            idle: t('report.resume.idle'),
            loading: t('report.resume.loading'),
            error: t('report.resume.error'),
            retry: t('report.resume.retry'),
            targetLabel: t('report.resume.targetLabel'),
            scoreLabel: t('report.resume.scoreLabel'),
            tierHigh: t('report.resume.tierHigh'),
            tierMid: t('report.resume.tierMid'),
            tierLow: t('report.resume.tierLow'),
            previewLabel: t('report.resume.previewLabel'),
            print: t('report.resume.print'),
            downloadMd: t('report.resume.downloadMd'),
            close: t('report.resume.close'),
            localToggle: t('report.resume.localToggle'),
            localPrivacy: t('report.resume.localPrivacy'),
            fieldName: t('report.resume.fieldName'),
            fieldEmail: t('report.resume.fieldEmail'),
            fieldPhone: t('report.resume.fieldPhone'),
            fieldLocation: t('report.resume.fieldLocation'),
            fieldSite: t('report.resume.fieldSite'),
            fieldLinkedIn: t('report.resume.fieldLinkedIn'),
            educationLabel: t('report.resume.educationLabel'),
            workLabel: t('report.resume.workLabel'),
            addEducation: t('report.resume.addEducation'),
            addWork: t('report.resume.addWork'),
            remove: t('report.resume.remove'),
            applyLocal: t('report.resume.applyLocal'),
            suggestionsTitle: t('report.resume.suggestionsTitle'),
            gapsTitle: t('report.resume.gapsTitle'),
            schoolPlaceholder: t('report.resume.schoolPlaceholder'),
            degreePlaceholder: t('report.resume.degreePlaceholder'),
            startPlaceholder: t('report.resume.startPlaceholder'),
            endPlaceholder: t('report.resume.endPlaceholder'),
            companyPlaceholder: t('report.resume.companyPlaceholder'),
            rolePlaceholder: t('report.resume.rolePlaceholder'),
            detailPlaceholder: t('report.resume.detailPlaceholder'),
            polishToggle: t('report.resume.polishToggle'),
            polishHint: t('report.resume.polishHint'),
            polishApplied: t('report.resume.polishApplied'),
            polishFallback: t('report.resume.polishFallback'),
            polishReasonNotConfigured: t('report.resume.polishReasonNotConfigured'),
            polishReasonProviderError: t('report.resume.polishReasonProviderError'),
            polishReasonValidationFailed: t('report.resume.polishReasonValidationFailed'),
            polishReasonFabricationDetected: t('report.resume.polishReasonFabricationDetected'),
            coverLetterLabel: t('report.resume.coverLetterLabel'),
            coverLetterHint: t('report.resume.coverLetterHint'),
            coverLetterGenerating: t('report.resume.coverLetterGenerating'),
            coverLetterDone: t('report.resume.coverLetterDone'),
            coverLetterError: t('report.resume.coverLetterError'),
            coverLetterNotConfigured: t('report.resume.coverLetterNotConfigured'),
            coverLetterAuthRequired: t('report.resume.coverLetterAuthRequired'),
            coverLetterRetry: t('report.resume.coverLetterRetry'),
            coverLetterCopy: t('report.resume.coverLetterCopy'),
            coverLetterCopied: t('report.resume.coverLetterCopied'),
            coverLetterDownload: t('report.resume.coverLetterDownload'),
            manualHint: t('report.resume.manualHint'),
            manualTitle: t('report.resume.manualTitle'),
            manualTitlePlaceholder: t('report.resume.manualTitlePlaceholder'),
            manualCompany: t('report.resume.manualCompany'),
            manualCompanyPlaceholder: t('report.resume.manualCompanyPlaceholder'),
            manualJd: t('report.resume.manualJd'),
            manualJdPlaceholder: t('report.resume.manualJdPlaceholder'),
            manualGenerate: t('report.resume.manualGenerate'),
            manualMissing: t('report.resume.manualMissing'),
          }}
          />
        </div>
      )
    }

    <!-- 活跃度——仅求职者视角 -->
    {
      !isRecruiter && (
        <section class="ja-card">
          <h2>{t('report.activity.title')}</h2>
          <div class="ja-stack-2">
            {profile.activity.longevityMonths !== undefined && (
              <div class="ja-flex-between">
                <span class="ja-muted">{t('report.activity.longevityMonths')}</span>
                <strong>{t('report.activity.months', { count: profile.activity.longevityMonths })}</strong>
              </div>
            )}
            {profile.activity.cadenceSummary &&
              typeof profile.activity.metrics?.totalCommits === 'number' &&
              typeof profile.activity.metrics?.activeMonths === 'number' &&
              profile.activity.metrics.activeMonths > 0 && (
                <div class="ja-flex-between">
                  <span class="ja-muted">{t('report.activity.cadence')}</span>
                  <strong>
                    {composeCadenceSummary(
                      { commits: profile.activity.metrics.totalCommits, months: profile.activity.metrics.activeMonths },
                      locale,
                    )}
                  </strong>
                </div>
              )}
            {profile.activity.metrics && Object.keys(profile.activity.metrics).length > 0 && (
              <div class="metrics-grid">
                {Object.entries(profile.activity.metrics).map(([key, value]) => (
                  <div class="metric">
                    <span class="metric-value">{formatNumber(value, locale)}</span>
                    <span class="ja-muted metric-key">{key}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )
    }

    <!-- 协作度——仅求职者视角 -->
    {
      !isRecruiter &&
        (profile.collaboration.prSummary ||
          (profile.collaboration.externalMergedContributions &&
            profile.collaboration.externalMergedContributions.length > 0)) && (
        <section class="ja-card">
          <h2>{t('report.collaboration.title')}</h2>
          <div class="ja-stack-2">
            {profile.collaboration.prSummary && (() => {
              const facts = prSummaryFactsFromProfile(profile);
              return <p>{facts ? composePrSummary(facts, locale) : profile.collaboration.prSummary}</p>;
            })()}
            {profile.collaboration.externalMergedContributions &&
              profile.collaboration.externalMergedContributions.length > 0 && (
                <div>
                  <h3 class="kind-label">{t('report.collaboration.externalMerged')}</h3>
                  <ul class="merged-list">
                    {profile.collaboration.externalMergedContributions.map((repo) => (
                      <li>{repo}</li>
                    ))}
                  </ul>
                </div>
              )}
          </div>
        </section>
      )
    }

    <!-- 面试题（授权分级闸）：未登录只见题数与登录入口；登录 user 可见题目/依据/面试包下载 -->
    {
      profile.interviewQuestions.length > 0 &&
        (canViewGated ? (
        <section class="ja-card">
          <div class="ja-flex-between">
            <h2>{t('report.interview.title')}</h2>
            {
              !isRecruiter && (
                <a class="ja-btn ja-btn--ghost interview-kit-link" href={interviewKitUrl}>
                  ⬇ {t('report.interview.downloadKit')}
                </a>
              )
            }
          </div>
          <div class="ja-stack-3">
            {profile.interviewQuestions.map((iq) => {
              const qEvidence = isRecruiter
                ? resolveEvidence(iq.basisEvidenceRef ? [iq.basisEvidenceRef] : [])
                : [];
              return (
                <div class="interview-item">
                  <p class="question">{iq.question}</p>
                  <p class="ja-muted intent">
                    {t('report.interview.intent')}: {composeInterviewIntent(iq.kind, locale, iq.intent)}
                  </p>
                  {
                    isRecruiter && qEvidence.length > 0 && (
                      <ul class="evidence-links">
                        {qEvidence.map((ev) => (
                          <li>
                            <a href={ev.url} target="_blank" rel="noopener noreferrer">
                              {ev.claim} ↗
                            </a>
                          </li>
                        ))}
                      </ul>
                    )
                  }
                </div>
              );
            })}
          </div>
        </section>
        ) : (
          <GateCard
            title={t('report.gate.interviewTitle')}
            body={gateInterviewBody}
            loginHref={loginHref}
            loginLabel={gateLoginLabel}
            testId="interview-gate"
          />
        ))
    }

    <!-- 投递追踪（仅求职者视角；2026-10-08 收紧后仅主体本人可用：已认领画像只对本人出现，
         未认领画像对他人不再展示可写入口，见走查 #8 与 auth.canViewApplications） -->
    {
      !isRecruiter && canUseApplications && (
        <div id="applications-section" class="applications-anchor">
          <ApplicationTracker
          client:load
          profileId={profileId!}
          apiBase={apiBase}
          locale={locale}
          labels={{
            title: t('applications.title'),
            hint: t('applications.hint'),
            loading: t('applications.loading'),
            error: t('applications.error'),
            empty: t('applications.empty'),
            add: t('applications.add'),
            company: t('applications.company'),
            role: t('applications.role'),
            url: t('applications.url'),
            status: t('applications.status'),
            note: t('applications.note'),
            appliedAt: t('applications.appliedAt'),
            aiAssisted: t('applications.aiAssisted'),
            companyPlaceholder: t('applications.companyPlaceholder'),
            rolePlaceholder: t('applications.rolePlaceholder'),
            urlPlaceholder: t('applications.urlPlaceholder'),
            notePlaceholder: t('applications.notePlaceholder'),
            save: t('applications.save'),
            cancel: t('applications.cancel'),
            required: t('applications.required'),
            statusLabels: applicationStatusLabels,
            outcome: t('applications.outcome'),
            outcomeUnset: t('applications.outcome.unset'),
            outcomeLabels: applicationOutcomeLabels,
          }}
          />
        </div>
      )
    }

    <!-- 未认领画像的投递锁定提示（走查 #8 前端侧）：本人之外不展示可写入口，
         给主体本人一条"认领后解锁"的引导（非主体不泄露存在，什么都不显示）。 -->
    {
      !isRecruiter && !subjectClaimed && (
        <section class="ja-card applications-locked" data-testid="applications-locked">
          <h2>{t('applications.title')}</h2>
          <p class="ja-muted">{t('applications.locked')}</p>
          <a class="ja-link" href="#claim-section">
            {t('report.journey.step1')} →
          </a>
        </section>
      )
    }

    <!-- 简历声明自检（C 端）：仅求职者本人（已认领）视角；把产品从"被核验"变"先自查"，
         挂载判据与 API authorizeVerifier 的 isOwner 对齐（决策 #23 批次 2，design §7）。 -->
    {
      !isRecruiter && isProfileOwner && (
        <ClaimVerifier
          client:load
          apiBase={apiBase}
          profileId={profileId!}
          labels={{
            title: t('report.claims.self.title'),
            hint: t('report.claims.self.hint'),
            inputLabel: t('report.claims.inputLabel'),
            inputPlaceholder: t('report.claims.inputPlaceholder'),
            submit: t('report.claims.submit'),
            submitting: t('report.claims.submitting'),
            loading: t('report.claims.loading'),
            error: t('report.claims.error'),
            empty: t('report.claims.empty'),
            evidenceTitle: t('report.claims.evidence'),
            withdraw: t('report.claims.withdraw'),
            withdrawing: t('report.claims.withdrawing'),
            verdict: {
              supportable: t('report.claims.verdict.supportable'),
              partial: t('report.claims.verdict.partial'),
              no_trace: t('report.claims.verdict.no_trace'),
              insufficient_data: t('report.claims.verdict.insufficient_data'),
            },
          }}
        />
      )
    }

    <!-- 数据主体权益（2026-10-08 走查 #5 降级）：未认领画像的「按主体撤回」申请入口
         从 header 主操作位移到这里；合规通道保留、不占主位。已软挂起由顶部标注条接管。 -->
    {
      !subjectClaimed && !isHeldForRemoval && (
        <section class="ja-card data-rights" data-testid="data-rights">
          <h2>{t('report.dataRights.title')}</h2>
          <RemovalRequest
            client:load
            apiBase={apiBase}
            profileId={profileId!}
            ctaLabel={t('report.removal.cta')}
            submittingLabel={t('report.removal.submitting')}
            submittedLabel={t('report.removal.submitted')}
            errorLabel={t('report.removal.error')}
            reasonPlaceholder={t('report.removal.reasonPlaceholder')}
            contactPlaceholder={t('report.removal.contactPlaceholder')}
            hintLabel={t('report.removal.hint')}
          />
        </section>
      )
    }

    <!-- 局限与说明 -->
    <section class="ja-card caveats">
      <h2>{t('report.caveats.title')}</h2>
      {
        profile.caveats.length > 0 && (
          <ul class="ja-stack-1">
            {profile.caveats.map((caveat) => (
              <li>{caveat}</li>
            ))}
          </ul>
        )
      }
      <p class="dispute">
        <a
          href={`mailto:${disputeEmail}?subject=${encodeURIComponent(
            `${t('report.dispute.subject')}: ${profileId}`,
          )}`}
        >
          {t('report.dispute')}
        </a>
        {' — '}
        {t('report.dispute.body')}
      </p>
    </section>
  </div>
</Layout>

<style>
  /* 2026-10-08 走查 #5/#6/#8：行动出口、数据主体权益、投递锁定提示与锚点滚动留白 */
  .journey {
    margin-top: var(--ja-space-5);
  }

  .journey-lead {
    margin-bottom: var(--ja-space-4);
  }

  .journey-steps {
    display: flex;
    flex-direction: column;
    gap: var(--ja-space-3);
  }

  .journey-step__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ja-space-3);
    flex-wrap: wrap;
  }

  .journey-step__status {
    font-size: var(--ja-text-sm);
  }

  .journey-step__locked {
    font-size: var(--ja-text-sm);
  }

  .journey-step__cta {
    font-size: var(--ja-text-sm);
    white-space: nowrap;
  }

  .data-rights {
    margin-top: var(--ja-space-4);
  }

  .data-rights h2 {
    margin-bottom: var(--ja-space-3);
  }

  /* 移除申请触发器：页脚次级文字链（不再是 header 主按钮） */
  .removal-request__trigger {
    cursor: pointer;
    color: var(--ja-color-accent);
    text-decoration: underline;
    font-size: var(--ja-text-sm);
    background: none;
    border: 0;
    padding: 0;
  }

  .applications-locked {
    margin-top: var(--ja-space-4);
  }

  .applications-locked h2 {
    margin-bottom: var(--ja-space-2);
  }

  .applications-locked .ja-link {
    display: inline-block;
    margin-top: var(--ja-space-3);
    font-size: var(--ja-text-sm);
  }

  .resume-extension-hint {
    margin-bottom: var(--ja-space-2);
    font-size: var(--ja-text-sm);
  }

  /* 锚点跳转时给 sticky header 留白 */
  .claim-anchor,
  .resume-anchor,
  .applications-anchor {
    scroll-margin-top: var(--ja-space-8);
  }
</style>
