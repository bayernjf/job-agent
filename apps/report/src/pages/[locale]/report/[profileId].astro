---
/**
 * 报告页 /[locale]/report/[profileId]——SSR 读取画像快照并渲染。
 * 分享链接固定指向此路由，语言段随链接固定（i18n 设计第 4 节）。
 */
import Layout from '../../../layouts/Layout.astro';
import ShareButton from '../../../components/ShareButton.tsx';
import ClaimProfile from '../../../components/ClaimProfile.tsx';
import GateCard from '../../../components/GateCard.astro';
import JobRecommendations from '../../../components/JobRecommendations.tsx';
import ResumeBuilder from '../../../components/ResumeBuilder.tsx';
import ApplicationTracker from '../../../components/ApplicationTracker.tsx';
import { loadProfileRecord, loadEvidence } from '../../../lib/db';
import { resolveViewer, canViewGatedContent, canViewApplications } from '../../../lib/auth';
import { isLocale, createTranslator, type Locale, type MessageKey } from '../../../i18n/index.js';
import { formatDateTime, formatPercent, formatNumber, authenticityClass } from '../../../lib/format';
import { browserApiBase } from '../../../lib/api-base.js';
import type { EvidenceItem, SkillTagKind } from '@jobagent/shared';

const { locale: rawLocale, profileId } = Astro.params;
if (!isLocale(rawLocale)) {
  return Astro.redirect('/en/');
}
const locale: Locale = rawLocale;
const t = createTranslator(locale);

// API 地址：显式 PUBLIC_API_BASE 优先；Vercel 同域为 /api；本地默认同源
const apiBase = browserApiBase();

const disputeEmail =
  (import.meta.env.PUBLIC_DISPUTE_EMAIL as string | undefined) ?? 'dispute@job-agent.bayjf.com';

const profileRecord = profileId ? await loadProfileRecord(profileId) : null;
const profile = profileRecord?.snapshot ?? null;

// 画像不存在：渲染 404 状态页（profile 由 profileRecord 解出，两者同生同灭；一并判空以便下游收窄类型）
if (!profile || !profileRecord) {
  return Astro.redirect(`/${locale}/?notfound=1`);
}

// 融合画像标识只存在于存储行 subjectPlatform 列（snapshot.subject.platform 恒为主源 github）
const isFusedProfile = profileRecord?.subjectPlatform === 'all';

// 双源融合去重统计：仅当快照带 fusion 报告且确有镜像合并/去重时展示，全 0 则不渲染
const fusion = profile.fusion;
const fusionStats: { n: number; labelKey: MessageKey }[] = fusion
  ? [
      { n: fusion.mergedMirrors.length, labelKey: 'report.fusion.statMirrors' },
      { n: fusion.dedupedCommitCount, labelKey: 'report.fusion.statCommits' },
      { n: fusion.dedupedPullRequestCount, labelKey: 'report.fusion.statPrs' },
      { n: fusion.dedupedIssueCount, labelKey: 'report.fusion.statIssues' },
    ].filter((s) => s.n > 0)
  : [];

// 视角：默认求职者；?view=recruiter 为招聘方核验视图（只看可核验证据，隐藏求职建议）
const isRecruiter = Astro.url.searchParams.get('view') === 'recruiter';
const pathname = Astro.url.pathname;
const recruiterUrl = `${pathname}?view=recruiter`;
const candidateUrl = pathname;

// 授权分级闸（2026-09-19）：SSR 解析登录态。未登录（anonymous/demo）看公开门面，
// 完整证据外链与面试题/面试准备包折叠为登录墙；任何已登录 user（含招聘方）解锁。
const viewer = await resolveViewer(Astro.request.headers.get('cookie'));
const canViewGated = canViewGatedContent(viewer);
// 投递管道隐私（#17-F11）：画像一经认领即收归本人，判据与 API requireProfileOwner 一致
const canUseApplications = canViewApplications(viewer, profileRecord);
// 登录后回跳当前页（含 ?view=recruiter）；return_to 为同源相对路径，后端再做一次白名单校验。
// 登录墙按画像主体平台选登录方式：Gitee 画像引导 Gitee 登录，其余（含双源融合，主源 GitHub）走 GitHub。
const loginPlatform: 'github' | 'gitee' = profile.subject.platform === 'gitee' ? 'gitee' : 'github';
const loginHref = `${apiBase}/auth/${loginPlatform}/login?return_to=${encodeURIComponent(
  `${pathname}${Astro.url.search}`,
)}`;
const gateLoginLabel =
  loginPlatform === 'gitee' ? t('report.gate.loginButtonGitee') : t('report.gate.loginButton');
const gateEvidenceBody =
  loginPlatform === 'gitee' ? t('report.gate.evidenceBodyGitee') : t('report.gate.evidenceBody');
const gateInterviewBody =
  loginPlatform === 'gitee'
    ? t('report.gate.interviewBodyGitee', { count: profile.interviewQuestions.length })
    : t('report.gate.interviewBody', { count: profile.interviewQuestions.length });

// 证据明细（含完整外链 URL）：画像快照里只有 evidenceId，核验视图/面试准备包需要可点击链接
const evidenceList = profileId ? await loadEvidence(profileId) : [];
const evidenceById = new Map(evidenceList.map((e) => [e.evidenceId, e]));
const resolveEvidence = (refs: string[] | undefined | null): EvidenceItem[] =>
  (refs ?? [])
    .map((ref) => evidenceById.get(ref))
    .filter((e): e is EvidenceItem => Boolean(e && e.url));

// 真实性状态文案 key
const authLabelKey = `report.authenticity.${profile.authenticity.status}` as MessageKey;
const authClass = authenticityClass(profile.authenticity.status);

// 能力标签按 kind 分组
const skillGroups: Record<SkillTagKind, typeof profile.skillTags> = {
  language: profile.skillTags.filter((s) => s.kind === 'language'),
  framework: profile.skillTags.filter((s) => s.kind === 'framework'),
  domain: profile.skillTags.filter((s) => s.kind === 'domain'),
};

const shareUrl = Astro.url.href;
// 扩展面板"生成简历"深链：?resumeJob=<jobId>，ResumeBuilder mount 后自动生成
const resumeJobId = Astro.url.searchParams.get('resumeJob') ?? undefined;
const generatedAt = formatDateTime(profile.generatedAt, locale);
const since = formatDateTime(profile.dataWindow.since, locale);
const until = formatDateTime(profile.dataWindow.until, locale);
const interviewKitUrl = `${pathname}/interview-kit.md`;

// 投递状态文案映射（传给 ApplicationTracker island）
const applicationStatusLabels = {
  saved: t('applications.status.saved'),
  applied: t('applications.status.applied'),
  viewed: t('applications.status.viewed'),
  interview: t('applications.status.interview'),
  offer: t('applications.status.offer'),
  rejected: t('applications.status.rejected'),
  withdrawn: t('applications.status.withdrawn'),
};
---

<Layout locale={locale} title={profile.subject.login}>
  <div class="ja-container">
    <!-- 头部：账号信息 + 真实性徽章 + 分享 -->
    <section class="ja-card profile-header">
      <div class="profile-id">
        {
          profile.subject.avatarUrl && (
            <img src={profile.subject.avatarUrl} alt={profile.subject.login} class="avatar" width="64" height="64" />
          )
        }
        <div>
          <h1 class="login">{profile.subject.displayName ?? profile.subject.login}</h1>
          <a href={profile.subject.profileUrl} target="_blank" rel="noopener noreferrer" class="ja-muted">
            @{profile.subject.login}
          </a>
        </div>
      </div>
      <div class="header-meta">
        {isFusedProfile && (
          <span class={`ja-badge ja-badge--fused`} title={t('report.fusion.badgeTitle')}>
            {t('report.fusion.badge')}
          </span>
        )}
        {
          /* 已认领：SSR 直接渲染本人已验证徽章，无需 JS */
          profile.subject.claimed && (
            <span class="ja-badge ja-badge--owner" data-testid="claimed-badge">
              {t('report.claimedBadge')}
            </span>
          )
        }
        {
          /* 未认领且非融合画像：挂载认领 island，仅登录且主体一致的本人会看到 CTA */
          !profile.subject.claimed && !isFusedProfile && (
            <ClaimProfile
              client:load
              apiBase={apiBase}
              profileId={profileId!}
              subjectPlatform={profile.subject.platform}
              subjectLogin={profile.subject.login}
              ctaLabel={t('report.claim.cta')}
              claimingLabel={t('report.claim.claiming')}
              claimedBadge={t('report.claimedBadge')}
              errorLabel={t('report.claim.error')}
              hintLabel={t('report.claim.hint')}
              unclaimedNoticeTestId="unclaimed-notice"
            />
          )
        }
        <span class={`ja-badge ${authClass}`}>{t(authLabelKey)}</span>
        <a
          class="ja-btn ja-btn--ghost view-toggle"
          href={isRecruiter ? candidateUrl : recruiterUrl}
          aria-pressed={isRecruiter}
        >
          {isRecruiter ? t('report.view.switchToCandidate') : t('report.view.switchToRecruiter')}
        </a>
        <ShareButton
          client:load
          url={shareUrl}
          copyLabel={t('report.copyLink')}
          copiedLabel={t('report.shareCopied')}
        />
      </div>
      {
        isFusedProfile && fusionStats.length > 0 && (
          <p class="ja-fusion-stats" data-testid="fusion-stats">
            {fusionStats.map((s) => (
              <span class="ja-fusion-stat">
                <strong>{s.n}</strong>&nbsp;{t(s.labelKey)}
              </span>
            ))}
          </p>
        )
      }
      {
        /* 决策 #1-A：未授权画像必须显著标注来源与效力边界 */
        !profile.subject.claimed && (
          <p class="unclaimed-notice" data-testid="unclaimed-notice" role="note">
            {t('report.unclaimedNotice')}
          </p>
        )
      }
    </section>

    {
      isRecruiter &&
        (canViewGated ? (
          <section class="ja-card recruiter-banner">
            <p>{t('report.view.recruiterBanner')}</p>
          </section>
        ) : (
          <GateCard
            title={t('report.gate.evidenceTitle')}
            body={gateEvidenceBody}
            loginHref={loginHref}
            loginLabel={gateLoginLabel}
            testId="evidence-gate"
          />
        ))
    }

    <!-- 元信息：生成时间 / 版本 / 时间窗 -->
    <section class="meta-bar">
      <span class="ja-muted">{t('report.generatedAt')}: {generatedAt}</span>
      <span class="ja-muted">{t('report.analyzerVersion')}: {profile.analyzerVersion}</span>
      <span class="ja-muted">{t('report.dataWindow')}: {since} – {until}</span>
    </section>

    <!-- 概述 -->
    <section class="ja-card">
      <h2>{t('report.summary.title')}</h2>
      <p class="headline">{profile.summary.headline}</p>
    </section>

    <!-- 真实性评估 -->
    <section class="ja-card">
      <div class="ja-flex-between">
        <h2>{t('report.authenticity.title')}</h2>
        <span class="ja-muted">
          {t('report.authenticity.confidence')}: {formatPercent(profile.authenticity.confidence, locale)}
        </span>
      </div>
      <div class="ja-stack-2 signals">
        {
          profile.authenticity.signals.map((signal) => {
            const sigEvidence = isRecruiter && canViewGated ? resolveEvidence(signal.evidenceRefs) : [];
            return (
              <div class={`signal signal--${signal.severity}`}>
                <div class="ja-flex-between">
                  <strong>{signal.label}</strong>
                  <span class="ja-muted signal-code">{signal.code}</span>
                </div>
                <p>{signal.detail}</p>
                {
                  isRecruiter && canViewGated && sigEvidence.length > 0 && (
                    <ul class="evidence-links">
                      {sigEvidence.map((ev) => (
                        <li>
                          <a href={ev.url} target="_blank" rel="noopener noreferrer">
                            {ev.claim} ↗
                          </a>
                        </li>
                      ))}
                    </ul>
                  )
                }
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- 能力标签 -->
    {
      profile.skillTags.length > 0 && (
        <section class="ja-card">
          <h2>{t('report.skills.title')}</h2>
          <div class="ja-stack-3">
            {(Object.keys(skillGroups) as SkillTagKind[]).map((kind) =>
              skillGroups[kind].length > 0 ? (
                <div>
                  <h3 class="kind-label">{t(`report.skills.kind.${kind}` as MessageKey)}</h3>
                  <div class="tag-list">
                    {skillGroups[kind].map((tag) => (
                      <span class={`skill-tag skill-tag--${tag.depth}`}>
                        {tag.name}
                        <span class="depth-mark">{t(`report.skills.depth.${tag.depth}` as MessageKey)}</span>
                      </span>
                    ))}
                  </div>
                </div>
              ) : null,
            )}
            {
              isRecruiter && canViewGated && (
                <div class="skill-evidence">
                  <h3 class="kind-label">{t('report.recruiter.skillEvidence')}</h3>
                  <ul class="ja-stack-1">
                    {profile.skillTags.flatMap((tag) =>
                      resolveEvidence(tag.evidenceRefs).map((ev) => (
                        <li class="skill-evidence-row">
                          <span class="skill-evidence-name">{tag.name}</span>
                          <a href={ev.url} target="_blank" rel="noopener noreferrer">
                            {ev.claim} ↗
                          </a>
                        </li>
                      )),
                    )}
                  </ul>
                </div>
              )
            }
          </div>
        </section>
      )
    }

    <!-- 推荐岗位（第一档匹配接线）——仅求职者视角 -->
    {
      !isRecruiter && profile.skillTags.length > 0 && (
        <JobRecommendations
          client:load
          profileId={profileId!}
          apiBase={apiBase}
          locale={locale}
          title={t('report.recommendations.title')}
          loadingText={t('report.recommendations.loading')}
          errorText={t('report.recommendations.error')}
          emptyText={t('report.recommendations.empty')}
          scoreLabel={t('report.recommendations.score')}
          matchedSkillsLabel={t('report.recommendations.matchedSkills')}
          viewJobLabel={t('report.recommendations.viewJob')}
          remoteLabel={t('report.recommendations.remote')}
          basisLabel={t('report.recommendations.basis')}
          fieldTitleLabel={t('report.recommendations.fieldTitle')}
          fieldTagsLabel={t('report.recommendations.fieldTags')}
          fieldDescriptionLabel={t('report.recommendations.fieldDescription')}
          depthUsedLabel={t('report.skills.depth.used')}
          depthProficientLabel={t('report.skills.depth.proficient')}
          evidenceCountTemplate={t('report.evidence.count')}
          viewEvidenceLabel={t('report.evidence.viewOriginal')}
          generateResumeLabel={t('report.resume.generateButton')}
        />
      )
    }

    <!-- 岗位定向简历（P-R2）：由上方岗位卡片按钮经 DOM 事件触发——仅求职者视角 -->
    {
      !isRecruiter && profile.skillTags.length > 0 && (
        <ResumeBuilder
          client:load
          profileId={profileId!}
          apiBase={apiBase}
          locale={locale}
          initialJobId={resumeJobId}
          labels={{
            sectionTitle: t('report.resume.sectionTitle'),
            sectionHint: t('report.resume.sectionHint'),
            idle: t('report.resume.idle'),
            loading: t('report.resume.loading'),
            error: t('report.resume.error'),
            retry: t('report.resume.retry'),
            targetLabel: t('report.resume.targetLabel'),
            scoreLabel: t('report.resume.scoreLabel'),
            tierHigh: t('report.resume.tierHigh'),
            tierMid: t('report.resume.tierMid'),
            tierLow: t('report.resume.tierLow'),
            previewLabel: t('report.resume.previewLabel'),
            print: t('report.resume.print'),
            downloadMd: t('report.resume.downloadMd'),
            close: t('report.resume.close'),
            localToggle: t('report.resume.localToggle'),
            localPrivacy: t('report.resume.localPrivacy'),
            fieldName: t('report.resume.fieldName'),
            fieldEmail: t('report.resume.fieldEmail'),
            fieldPhone: t('report.resume.fieldPhone'),
            fieldLocation: t('report.resume.fieldLocation'),
            fieldSite: t('report.resume.fieldSite'),
            fieldLinkedIn: t('report.resume.fieldLinkedIn'),
            educationLabel: t('report.resume.educationLabel'),
            workLabel: t('report.resume.workLabel'),
            addEducation: t('report.resume.addEducation'),
            addWork: t('report.resume.addWork'),
            remove: t('report.resume.remove'),
            applyLocal: t('report.resume.applyLocal'),
            suggestionsTitle: t('report.resume.suggestionsTitle'),
            gapsTitle: t('report.resume.gapsTitle'),
            schoolPlaceholder: t('report.resume.schoolPlaceholder'),
            degreePlaceholder: t('report.resume.degreePlaceholder'),
            startPlaceholder: t('report.resume.startPlaceholder'),
            endPlaceholder: t('report.resume.endPlaceholder'),
            companyPlaceholder: t('report.resume.companyPlaceholder'),
            rolePlaceholder: t('report.resume.rolePlaceholder'),
            detailPlaceholder: t('report.resume.detailPlaceholder'),
            polishToggle: t('report.resume.polishToggle'),
            polishHint: t('report.resume.polishHint'),
            polishApplied: t('report.resume.polishApplied'),
            polishFallback: t('report.resume.polishFallback'),
            polishReasonNotConfigured: t('report.resume.polishReasonNotConfigured'),
            polishReasonProviderError: t('report.resume.polishReasonProviderError'),
            polishReasonValidationFailed: t('report.resume.polishReasonValidationFailed'),
            polishReasonFabricationDetected: t('report.resume.polishReasonFabricationDetected'),
          }}
        />
      )
    }

    <!-- 活跃度——仅求职者视角 -->
    {
      !isRecruiter && (
        <section class="ja-card">
          <h2>{t('report.activity.title')}</h2>
          <div class="ja-stack-2">
            {profile.activity.longevityMonths !== undefined && (
              <div class="ja-flex-between">
                <span class="ja-muted">{t('report.activity.longevityMonths')}</span>
                <strong>{t('report.activity.months', { count: profile.activity.longevityMonths })}</strong>
              </div>
            )}
            {profile.activity.cadenceSummary && (
              <div class="ja-flex-between">
                <span class="ja-muted">{t('report.activity.cadence')}</span>
                <strong>{profile.activity.cadenceSummary}</strong>
              </div>
            )}
            {profile.activity.metrics && Object.keys(profile.activity.metrics).length > 0 && (
              <div class="metrics-grid">
                {Object.entries(profile.activity.metrics).map(([key, value]) => (
                  <div class="metric">
                    <span class="metric-value">{formatNumber(value, locale)}</span>
                    <span class="ja-muted metric-key">{key}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )
    }

    <!-- 协作度——仅求职者视角 -->
    {
      !isRecruiter &&
        (profile.collaboration.prSummary ||
          (profile.collaboration.externalMergedContributions &&
            profile.collaboration.externalMergedContributions.length > 0)) && (
        <section class="ja-card">
          <h2>{t('report.collaboration.title')}</h2>
          <div class="ja-stack-2">
            {profile.collaboration.prSummary && <p>{profile.collaboration.prSummary}</p>}
            {profile.collaboration.externalMergedContributions &&
              profile.collaboration.externalMergedContributions.length > 0 && (
                <div>
                  <h3 class="kind-label">{t('report.collaboration.externalMerged')}</h3>
                  <ul class="merged-list">
                    {profile.collaboration.externalMergedContributions.map((repo) => (
                      <li>{repo}</li>
                    ))}
                  </ul>
                </div>
              )}
          </div>
        </section>
      )
    }

    <!-- 面试题（授权分级闸）：未登录只见题数与登录入口；登录 user 可见题目/依据/面试包下载 -->
    {
      profile.interviewQuestions.length > 0 &&
        (canViewGated ? (
        <section class="ja-card">
          <div class="ja-flex-between">
            <h2>{t('report.interview.title')}</h2>
            {
              !isRecruiter && (
                <a class="ja-btn ja-btn--ghost interview-kit-link" href={interviewKitUrl}>
                  ⬇ {t('report.interview.downloadKit')}
                </a>
              )
            }
          </div>
          <div class="ja-stack-3">
            {profile.interviewQuestions.map((iq) => {
              const qEvidence = isRecruiter
                ? resolveEvidence(iq.basisEvidenceRef ? [iq.basisEvidenceRef] : [])
                : [];
              return (
                <div class="interview-item">
                  <p class="question">{iq.question}</p>
                  <p class="ja-muted intent">
                    {t('report.interview.intent')}: {iq.intent}
                  </p>
                  {
                    isRecruiter && qEvidence.length > 0 && (
                      <ul class="evidence-links">
                        {qEvidence.map((ev) => (
                          <li>
                            <a href={ev.url} target="_blank" rel="noopener noreferrer">
                              {ev.claim} ↗
                            </a>
                          </li>
                        ))}
                      </ul>
                    )
                  }
                </div>
              );
            })}
          </div>
        </section>
        ) : (
          <GateCard
            title={t('report.gate.interviewTitle')}
            body={gateInterviewBody}
            loginHref={loginHref}
            loginLabel={gateLoginLabel}
            testId="interview-gate"
          />
        ))
    }

    <!-- 投递追踪（仅求职者视角；已认领画像的管道只对本人出现，#17-F11） -->
    {
      !isRecruiter && canUseApplications && (
        <ApplicationTracker
          client:load
          profileId={profileId!}
          apiBase={apiBase}
          locale={locale}
          labels={{
            title: t('applications.title'),
            hint: t('applications.hint'),
            loading: t('applications.loading'),
            error: t('applications.error'),
            empty: t('applications.empty'),
            add: t('applications.add'),
            company: t('applications.company'),
            role: t('applications.role'),
            url: t('applications.url'),
            status: t('applications.status'),
            note: t('applications.note'),
            appliedAt: t('applications.appliedAt'),
            companyPlaceholder: t('applications.companyPlaceholder'),
            rolePlaceholder: t('applications.rolePlaceholder'),
            urlPlaceholder: t('applications.urlPlaceholder'),
            notePlaceholder: t('applications.notePlaceholder'),
            save: t('applications.save'),
            cancel: t('applications.cancel'),
            required: t('applications.required'),
            statusLabels: applicationStatusLabels,
          }}
        />
      )
    }

    <!-- 局限与说明 -->
    <section class="ja-card caveats">
      <h2>{t('report.caveats.title')}</h2>
      {
        profile.caveats.length > 0 && (
          <ul class="ja-stack-1">
            {profile.caveats.map((caveat) => (
              <li>{caveat}</li>
            ))}
          </ul>
        )
      }
      <p class="dispute">
        <a
          href={`mailto:${disputeEmail}?subject=${encodeURIComponent(
            `${t('report.dispute.subject')}: ${profileId}`,
          )}`}
        >
          {t('report.dispute')}
        </a>
        {' — '}
        {t('report.dispute.body')}
      </p>
    </section>
  </div>
</Layout>

<style>
  .profile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ja-space-4);
    flex-wrap: wrap;
  }

  .profile-id {
    display: flex;
    align-items: center;
    gap: var(--ja-space-4);
  }

  .avatar {
    border-radius: var(--ja-radius-lg);
    border: 1px solid var(--ja-color-border);
  }

  .login {
    font-size: var(--ja-text-xl);
    margin-bottom: var(--ja-space-1);
  }

  .header-meta {
    display: flex;
