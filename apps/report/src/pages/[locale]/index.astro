---
/**
 * 首页 /[locale]/——输入 GitHub 用户名，触发分析。
 * 客户端交互（创建任务、轮询状态、跳转）由 AnalyzeForm React island 处理。
 */
import Layout from '../../layouts/Layout.astro';
import AnalyzeForm from '../../components/AnalyzeForm.tsx';
import PresetList from '../../components/PresetList.tsx';
import { isLocale, type Locale } from '../../i18n/index.js';
import { createTranslator } from '../../i18n/index.js';
import { browserApiBase } from '../../lib/api-base.js';

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) {
  return Astro.redirect('/en/');
}
const locale: Locale = rawLocale;
const t = createTranslator(locale);

// API 地址：显式 PUBLIC_API_BASE 优先；Vercel 同域为 /api；本地默认同源
const apiBase = browserApiBase();

// T25：报告页 404 / DB 不可用跳回首页时带提示参数，首页如实说明而不是静默无反馈。
//   ?notfound=1    —— 画像不存在（404）
//   ?unavailable=1 —— 数据库/服务暂时不可用（503 语义）
const notice = Astro.url.searchParams.get('notfound')
  ? 'notfound'
  : Astro.url.searchParams.get('unavailable')
    ? 'unavailable'
    : null;
---

<Layout locale={locale} titleKey="home.title">
  <div class="ja-container">
    <section class="hero">
      {notice === 'notfound' && (
        <div class="ja-alert ja-alert--warn" role="status" data-testid="notfound-notice">
          {t('home.notFoundNotice')}
        </div>
      )}
      {notice === 'unavailable' && (
        <div class="ja-alert ja-alert--error" role="status" data-testid="unavailable-notice">
          {t('home.unavailableNotice')}
        </div>
      )}
      <h1>{t('home.title')}</h1>
      <p class="ja-muted subtitle">{t('home.subtitle')}</p>

      <div class="ja-card form-card">
        <AnalyzeForm
          client:load
          locale={locale}
          apiBase={apiBase}
          placeholder={t('home.placeholder')}
          analyzeLabel={t('home.analyze')}
          analyzingLabel={t('home.analyzing')}
          invalidLabel={t('home.invalidUsername')}
          queuedLabel={t('job.queued')}
          runningLabel={t('job.running')}
          failedLabel={t('job.failed')}
          timeoutLabel={t('home.unavailableNotice')}
          stageL0Label={t('job.stage.L0')}
          stageL1Label={t('job.stage.L1')}
          pollingLabel={t('job.polling')}
          retryLabel={t('job.retry')}
          attemptsLabel={t('job.attempts')}
          platformGithubLabel={t('home.platform.github')}
          platformGiteeLabel={t('home.platform.gitee')}
          platformAllLabel={t('home.platform.all')}
          startingDemoLabel={t('demo.starting')}
          quotaExceededLabel={t('demo.quotaExceeded')}
          rateLimitedLabel={t('demo.rateLimited')}
        />
      </div>

      <PresetList
        client:load
        locale={locale}
        apiBase={apiBase}
        title={t('demo.presets.title')}
        viewLabel={t('demo.presets.view')}
        authLabels={{
          likely_authentic: t('report.authenticity.likely_authentic'),
          mixed_signals: t('report.authenticity.mixed_signals'),
          suspicious: t('report.authenticity.suspicious'),
          insufficient_data: t('report.authenticity.insufficient_data'),
          unknown: t('report.authenticity.insufficient_data'),
        }}
      />
    </section>

    <section class="how-it-works">
      <h2>{t('home.howItWorks')}</h2>
      <div class="steps">
        <div class="ja-card step">
          <h3>{t('home.step1.title')}</h3>
          <p class="ja-muted">{t('home.step1.desc')}</p>
        </div>
        <div class="ja-card step">
          <h3>{t('home.step2.title')}</h3>
          <p class="ja-muted">{t('home.step2.desc')}</p>
        </div>
        <div class="ja-card step">
          <h3>{t('home.step3.title')}</h3>
          <p class="ja-muted">{t('home.step3.desc')}</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: var(--ja-space-8) 0 var(--ja-space-6);
  }

  .hero h1 {
    max-width: 600px;
    margin: 0 auto var(--ja-space-4);
  }

  .subtitle {
    max-width: 520px;
    margin: 0 auto var(--ja-space-6);
    font-size: var(--ja-text-lg);
  }

  .form-card {
    max-width: 480px;
    margin: 0 auto;
    text-align: left;
  }

  .how-it-works {
    margin-top: var(--ja-space-8);
  }

  .how-it-works h2 {
    text-align: center;
    margin-bottom: var(--ja-space-5);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ja-space-4);
  }

  .step h3 {
    margin-bottom: var(--ja-space-2);
    font-size: var(--ja-text-base);
  }

  @media (max-width: 640px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
