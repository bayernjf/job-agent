    "@jobagent/resume-core": "workspace:*",
    "@jobagent/shared": "workspace:*",
    "@jobagent/storage": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "undici": "^8.10.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0"
  }
}
