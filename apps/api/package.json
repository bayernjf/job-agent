{
  "name": "@jobagent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@jobagent/agent-core": "workspace:*",
    "@jobagent/claim-core": "workspace:*",
    "@jobagent/job-source": "workspace:*",
    "@jobagent/llm": "workspace:*",
    "@jobagent/resume-core": "workspace:*",
    "@jobagent/search-source": "workspace:*",
    "@jobagent/shared": "workspace:*",
    "@jobagent/storage": "workspace:*",
    "@jobagent/worker": "workspace:*",
    "hono": "^4.6.0",
    "undici": "^7.30.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4"
  }
}