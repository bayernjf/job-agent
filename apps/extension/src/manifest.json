{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.1.0",
  "key": "",
  "default_locale": "en",
  "description": "__MSG_appDescription__",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "__MSG_appName__"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*/*careers*",
        "https://*/*jobs*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:4321/*",
      "http://127.0.0.1:4321/*",
      "https://job-agent.bayjf.com/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "tokens.css",
        "panel.css"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*/*careers*",
    "https://*/*jobs*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://job-agent.bayjf.com/*"
  ]
}
