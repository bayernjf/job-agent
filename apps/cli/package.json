{
  "name": "@jobagent/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "jobagent": "./dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@jobagent/analyzer-core": "workspace:*",
    "@jobagent/gitee-source": "workspace:*",
    "@jobagent/github-source": "workspace:*",
    "@jobagent/job-source": "workspace:*",
    "@jobagent/resume-core": "workspace:*",
    "@jobagent/shared": "workspace:*",
    "@jobagent/storage": "workspace:*"
  }
}
