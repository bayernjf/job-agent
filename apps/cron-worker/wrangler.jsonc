{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jobagent-cron-worker",
  "main": "dist/index.js",
  "compatibility_date": "2025-10-06",
  // Five minutes for consumption, hourly for maintenance cleanup (UTC). The
  // handler drains serially inside one invocation, so a single analysis is
  // never processed by two overlapping ticks. The hourly slot also runs
  // /internal/cron/cleanup?task=all (expired sessions/accounts, aligned with
  // the CLI cleanup defaults), guarded by controller.cron in index.ts.
  "triggers": {
    // Daily 01:00 UTC (09:00 CST) email digest (decision #25, 2026-10-10).
    "crons": ["*/5 * * * *", "0 * * * *", "0 1 * * *"]
  },
  // Daily digest has two interchangeable send channels (2026-10-11): the
  // Cloudflare Email Service binding (EMAIL, requires the Workers Paid plan)
  // and the Resend HTTP API fallback (RESEND_API_KEY secret, free tier). Keep
  // the binding so upgrading the plan or switching providers needs no code
  // change; index.ts picks EMAIL first, Resend otherwise.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "PROD_ORIGIN": "https://app.job-agent.bayjf.com"
  }
  // CRON_SECRET and RESEND_API_KEY are NOT here: set them with
  // `wrangler secret put CRON_SECRET` / `wrangler secret put RESEND_API_KEY`.
}
